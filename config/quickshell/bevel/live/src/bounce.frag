#version 440
// Bevel live background — generated by live/build.py (run it inside live/, then compile with qsb). Colours: c1 accent, c2 accent2, c3 background, c4 highlight.
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    float time;
    float pixel;
    float dither;
    vec2 res;
    vec4 c1;
    vec4 c2;
    vec4 c3;
    vec4 c4;
};
float hash(vec2 p) { p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float hash1(float n) { return fract(sin(n) * 43758.5453); }
float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
}
float fbm(vec2 p) { float v = 0.0, a = 0.5; for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.02; a *= 0.5; } return v; }
vec3 pal(float t) {   // walk through the four theme colours
    t = fract(t) * 4.0;
    if (t < 1.0) return mix(c3.rgb, c1.rgb, t);
    if (t < 2.0) return mix(c1.rgb, c2.rgb, t - 1.0);
    if (t < 3.0) return mix(c2.rgb, c4.rgb, t - 2.0);
    return mix(c4.rgb, c3.rgb, t - 3.0);
}

vec2 bpos(float tm, vec2 area) { vec2 tt = tm * vec2(0.13, 0.09); return abs(fract(tt) * 2.0 - 1.0) * area; }
vec3 scene(vec2 uv, vec2 q) {
    // the old "DVD logo" screensaver, with the Bevel four panes and a fading trail
    vec2 box = vec2(0.24, 0.24);
    vec2 area = vec2(res.x / res.y, 1.0) - box;
    vec2 P = vec2(uv.x * res.x / res.y, uv.y);
    vec3 col = mix(c3.rgb * 0.5, c1.rgb * 0.25, uv.y);
    col += step(0.96, fract(P.x * 12.0)) * c1.rgb * 0.06 + step(0.96, fract(P.y * 12.0)) * c1.rgb * 0.06;
    for (int i = 6; i >= 1; i--) {
        vec2 p = P - bpos(time - float(i) * 0.12, area);
        if (p.x > 0.0 && p.y > 0.0 && p.x < box.x && p.y < box.y) col = mix(col, c1.rgb, 0.35 - float(i) * 0.05);
    }
    vec2 tt = time * vec2(0.13, 0.09);
    float hit = mod(floor(tt.x * 2.0 + 0.5) + floor(tt.y * 2.0 + 0.5), 4.0);
    vec2 p = P - bpos(time, area);
    if (p.x > 0.0 && p.y > 0.0 && p.x < box.x && p.y < box.y) {
        vec2 c = floor(p / box * 2.0);
        float k = mod(c.x + c.y * 2.0 + hit, 4.0);
        col = k < 1.0 ? c1.rgb : k < 2.0 ? c2.rgb : k < 3.0 ? c4.rgb : mix(c1.rgb, c3.rgb, 0.5);
        vec2 f = fract(p / box * 2.0);
        if (f.x < 0.06 || f.y > 0.94) col = mix(col, vec3(1.0), 0.5);
        if (f.x > 0.94 || f.y < 0.06) col *= 0.5;
    }
    return col;
}
// 4x4 ordered dither without arrays (works on every GLSL version, GLES 2 included)
float bayer2(vec2 a) { a = floor(a); return fract(dot(a, vec2(0.5, a.y * 0.75))); }
float bayer(vec2 p) { return bayer2(0.5 * p) * 0.25 + bayer2(p); }
void main() {
    float px = max(1.0, pixel);
    vec2 frag = qt_TexCoord0 * res;
    vec2 cell = floor(frag / px);
    vec2 p = (cell + 0.5) * px;               // chunky pixels
    vec2 uv = p / res;
    uv.y = 1.0 - uv.y;                         // y up
    vec3 col = scene(uv, (uv - 0.5) * vec2(res.x / res.y, 1.0));
    if (dither > 0.5) {                        // 90s ordered dither, 6 levels per channel
        float d = bayer(cell) - 0.5;
        col = floor(col * 5.0 + 0.5 + d) / 5.0;
    }
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0) * qt_Opacity;
}
