#version 440
// Bevel wallpaper effect — generated by live/build.py. Drawn over a picture, so it has alpha.
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    float time;
    float pixel;
    float density;
    vec2 res;
    vec4 c1;
    vec4 c2;
};
float hash(vec2 p) { p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
// one particle per grid cell (if the cell gets one): where it sits inside the cell, and its random number
vec3 cellp(vec2 g, float seed) {
    vec2 id = floor(g);
    float h = hash(id + seed);
    return vec3(vec2(hash(id + seed + 7.13), hash(id + seed + 3.71)) * 0.6 + 0.2, h);
}

vec4 effect(vec2 uv, vec2 q) {
    float a = 0.0;
    // twinkling stars, more of them higher up
    vec2 g = q / 0.025;
    vec3 c = cellp(g, 1.0);
    if (c.z < 0.22 * density * (0.4 + uv.y)) {
        float tw = pow(0.5 + 0.5 * sin(time * (1.0 + c.z * 9.0) + c.z * 60.0), 3.0);
        float d = length(fract(g) - c.xy) * 0.025;
        a = smoothstep(0.0034, 0.0012, d) * (0.35 + 0.65 * tw);
    }
    // now and then a shooting star
    float k = floor(time / 5.0);
    float t = fract(time / 5.0) * 5.0;
    if (t < 0.8 && hash(vec2(k, 2.0)) < 0.7 * density) {
        vec2 st = vec2(hash(vec2(k, 3.0)) - 0.2, 0.25 + 0.2 * hash(vec2(k, 4.0)));
        vec2 dir = normalize(vec2(1.0, -0.45));
        vec2 head = st + dir * t * 0.9;
        vec2 rel = q - head;
        float along = dot(rel, -dir), across = abs(dot(rel, vec2(-dir.y, dir.x)));
        float tail = step(0.0, along) * smoothstep(0.18, 0.0, along) * smoothstep(0.003, 0.0, across);
        a = max(a, tail * (1.0 - t / 0.8));
    }
    return vec4(c1.rgb, a);
}
void main() {
    float px = max(1.0, pixel);
    vec2 cell = floor(qt_TexCoord0 * res / px);
    vec2 p = (cell + 0.5) * px;               // chunky pixels
    vec2 uv = p / res;
    uv.y = 1.0 - uv.y;                         // y up
    vec4 e = effect(uv, (uv - 0.5) * vec2(res.x / res.y, 1.0));
    float a = clamp(e.a, 0.0, 1.0);
    fragColor = vec4(clamp(e.rgb, 0.0, 1.0) * a, a) * qt_Opacity;
}
