#version 440
// Bevel live background — generated by live/build.py (run it inside live/, then compile with qsb). Colours: c1 accent, c2 accent2, c3 background, c4 highlight.
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    float time;
    float pixel;
    float dither;
    vec2 res;
    vec4 c1;
    vec4 c2;
    vec4 c3;
    vec4 c4;
};
float hash(vec2 p) { p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float hash1(float n) { return fract(sin(n) * 43758.5453); }
float noise(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
}
float fbm(vec2 p) { float v = 0.0, a = 0.5; for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.02; a *= 0.5; } return v; }
vec3 pal(float t) {   // walk through the four theme colours
    t = fract(t) * 4.0;
    if (t < 1.0) return mix(c3.rgb, c1.rgb, t);
    if (t < 2.0) return mix(c1.rgb, c2.rgb, t - 1.0);
    if (t < 3.0) return mix(c2.rgb, c4.rgb, t - 2.0);
    return mix(c4.rgb, c3.rgb, t - 3.0);
}

vec3 scene(vec2 uv, vec2 q) {
    // the Bevel wallpaper, alive: sky, sun, drifting stripes, scrolling hills
    vec3 col = mix(c1.rgb * 0.75, c3.rgb, uv.y);
    vec2 s = q - vec2(0.42, 0.12);
    if (length(s) < 0.22 && fract((s.y + time * 0.05) * 18.0) > 0.25 * step(s.y, -0.02)) col = mix(c4.rgb, c2.rgb, 0.2);
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float sp = 0.03 + fi * 0.05;
        float x = uv.x * (2.0 + fi) + time * sp;
        float h = 0.42 - fi * 0.1 + 0.07 * sin(x * 3.0 + fi) + 0.04 * sin(x * 7.0 + fi * 2.0);
        h = floor(h * 60.0) / 60.0;
        if (uv.y < h) col = mix(c1.rgb, c3.rgb * 0.35, (fi + 1.0) / 4.5);
    }
    return col;
}
// 4x4 ordered dither without arrays (works on every GLSL version, GLES 2 included)
float bayer2(vec2 a) { a = floor(a); return fract(dot(a, vec2(0.5, a.y * 0.75))); }
float bayer(vec2 p) { return bayer2(0.5 * p) * 0.25 + bayer2(p); }
void main() {
    float px = max(1.0, pixel);
    vec2 frag = qt_TexCoord0 * res;
    vec2 cell = floor(frag / px);
    vec2 p = (cell + 0.5) * px;               // chunky pixels
    vec2 uv = p / res;
    uv.y = 1.0 - uv.y;                         // y up
    vec3 col = scene(uv, (uv - 0.5) * vec2(res.x / res.y, 1.0));
    if (dither > 0.5) {                        // 90s ordered dither, 6 levels per channel
        float d = bayer(cell) - 0.5;
        col = floor(col * 5.0 + 0.5 + d) / 5.0;
    }
    fragColor = vec4(clamp(col, 0.0, 1.0), 1.0) * qt_Opacity;
}
