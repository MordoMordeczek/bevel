#!/usr/bin/env python3
"""bevelctl — theme engine and helper for the Bevel Hyprland rice.

Commands
  bevelctl apply                      regenerate every theme file from settings + wallpaper
  bevelctl session                    log-in start-up: daemons, wallpaper, theme, shell (logs to ~/.cache/bevel/session.log)
  bevelctl restore                    set the saved wallpaper, then apply
  bevelctl wallpaper PATH             set a wallpaper (and recolor everything)
  bevelctl random [favorites]         pick a random wallpaper (or animation, when the live background is on)
  bevelctl live [KIND] [#COLOR] [PALETTE]   animated background (live list = the kinds; live off = picture)
  bevelctl set KEY VALUE [KEY VALUE]  change settings (dot paths, e.g. style.rounding 0), then apply
  bevelctl preset classic|soft|modern apply a style preset
  bevelctl get [KEY]                  print settings (or one value)
  bevelctl scales                     print valid display scales for each monitor (JSON)
  bevelctl keyboard [detect]          the keyboard layout Hyprland gets; detect = take your system's
  bevelctl update [--check]           get the newest Bevel from git and install it (--check: just look)
  bevelctl version                    the installed Bevel version
  bevelctl edit [WHAT]                open settings|user|hypr|keybinds|shell|kitty|folder in your editor
  bevelctl shot region|full|window    screenshot to ~/Pictures/Screenshots + clipboard
  bevelctl brightness up|down|get     change every backlight device (hybrid-GPU laptops)
  bevelctl fullscreen [full|max]      toggle fullscreen / maximize on the active window
  bevelctl reset                      restore default settings
  bevelctl doctor                     write a diagnostic report to ~/bevel-report.txt
  bevelctl distro [--json]            the distro name Bevel shows (and its logo, as JSON)
  bevelctl settings                   open the Bevel settings window
  bevelctl restart-apps [dolphin] [firefox]  reopen them in the current colours (tabs kept)
  bevelctl lock                      lock the screen
  bevelctl chime                     play the start-up chime
  bevelctl apps-setup                 theme the installed apps (VS Code, Audacious, mpv, btop…)
  bevelctl cp …                       control panel helpers (wifi, bluetooth, night light…); `bevelctl cp help`
  bevelctl theme list|export NAME|import FILE|undo   share your whole look as one .bevel file
  bevelctl welcome [keys]             the Welcome tour (or straight to the keyboard shortcuts)
  bevelctl controlpanel               open/close the control panel
  bevelctl fix-fonts [FILE…]          remove broken fi/fl ligatures from the pixel fonts
"""
import colorsys
import fcntl
import glob
import io
