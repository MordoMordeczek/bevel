  --bv-face: {p['face']}; --bv-face2: {p['face2']}; --bv-hi: {p['hi']}; --bv-lo: {p['lo']};
  --bv-dark: {p['dark']}; --bv-base: {p['base']}; --bv-text: {p['text']}; --bv-dim: {p['textDim']};
  --bv-accent: {p['accent']}; --bv-on-accent: {p['onAccent']};
  --bv-raised: inset -1px -1px var(--bv-dark), inset 1px 1px var(--bv-hi), inset -2px -2px var(--bv-lo), inset 2px 2px var(--bv-face2);
  --bv-sunken: inset 1px 1px var(--bv-lo), inset -1px -1px var(--bv-hi), inset 2px 2px var(--bv-dark), inset -2px -2px var(--bv-face2);

  --lwt-accent-color: var(--bv-face) !important;
  --lwt-text-color: var(--bv-text) !important;
  --lwt-tab-text: var(--bv-text) !important;
  --toolbar-bgcolor: var(--bv-face) !important;
  --toolbar-color: var(--bv-text) !important;
  --toolbar-field-background-color: var(--bv-base) !important;
  --toolbar-field-focus-background-color: var(--bv-base) !important;
  --toolbar-field-color: var(--bv-text) !important;
  --toolbar-field-focus-color: var(--bv-text) !important;
  --toolbar-field-border-color: transparent !important;
  --toolbar-field-focus-border-color: var(--bv-accent) !important;
  --tab-selected-bgcolor: var(--bv-face2) !important;
  --tab-selected-textcolor: var(--bv-text) !important;
  --arrowpanel-background: var(--bv-face) !important;
  --arrowpanel-color: var(--bv-text) !important;
  --arrowpanel-border-color: var(--bv-dark) !important;
  --arrowpanel-border-radius: 0 !important;
  --panel-border-radius: 0 !important;
  --tab-border-radius: 0 !important;
  --toolbarbutton-border-radius: 0 !important;
  --urlbar-icon-border-radius: 0 !important;
  --focus-outline-color: var(--bv-accent) !important;
  --toolbarbutton-icon-fill: var(--bv-text) !important;
