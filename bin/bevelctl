def write_btop(s, p):
    if not shutil.which("btop"):
        return
    a, acc, acc2 = p["ansi"], p["accent"], p["accent2"]
    th = {
        "main_bg": p["termBg"], "main_fg": p["termFg"], "title": p["termFg"], "hi_fg": acc2,
        "selected_bg": acc, "selected_fg": p["onAccent"], "inactive_fg": a["color8"], "graph_text": p["termFg"],
        "meter_bg": a["color8"], "proc_misc": acc2, "cpu_box": acc, "mem_box": acc, "net_box": acc, "proc_box": acc,
        "div_line": a["color8"], "temp_start": a["color2"], "temp_mid": a["color3"], "temp_end": a["color1"],
        "cpu_start": acc, "cpu_mid": acc2, "cpu_end": a["color1"], "free_start": a["color2"], "free_mid": "", "free_end": a["color10"],
        "cached_start": acc, "cached_mid": "", "cached_end": acc2, "available_start": a["color3"], "available_mid": "",
        "available_end": a["color11"], "used_start": a["color1"], "used_mid": "", "used_end": a["color9"],
        "download_start": acc, "download_mid": acc2, "download_end": p["hi"], "upload_start": a["color5"],
        "upload_mid": a["color13"], "upload_end": p["hi"], "process_start": acc, "process_mid": acc2, "process_end": a["color1"],
    }
    d = os.path.join(HOME, ".config", "btop")
    theme_path = os.path.join(d, "themes", "bevel.theme")
    write_atomic(theme_path, "# bevel-generated\n" + "".join('theme[%s]="%s"\n' % kv for kv in th.items()))
    conf = os.path.join(d, "btop.conf")
    want = {"color_theme": '"%s"' % theme_path, "theme_background": "True", "rounded_corners": "False",
            "graph_symbol": '"block"', "truecolor": "True"}
    lines = []
    if os.path.exists(conf):
        with open(conf) as f:
            lines = f.read().splitlines()
        if any(ln.startswith("#bevel: hands off") for ln in lines):
            return
    seen = set()
    for i, ln in enumerate(lines):
        k = ln.split("=", 1)[0].strip()
        if k in want and not ln.lstrip().startswith("#"):
            lines[i] = "%s = %s" % (k, want[k])
            seen.add(k)
    lines += ["%s = %s" % (k, v) for k, v in want.items() if k not in seen]
    write_atomic(conf, "\n".join(lines) + "\n")


