def write_sddm(s, p):
    """Sync the login screen. The installer makes these two files writable by you,
    so this needs no root."""
    conf = os.path.join(SDDM_DIR, "theme.conf.user")
    bg = os.path.join(SDDM_DIR, "background.png")
    if not s.get("login", {}).get("sync", True) or not os.access(conf, os.W_OK):
        return
    wp = expand(s.get("login", {}).get("wallpaper") or "") or wall_path(s)
    old = configparser.RawConfigParser()
    old.optionxform = str
    try:
        old.read(conf)
    except configparser.Error:
        pass
    prev_src = old.get("General", "wallpaperSource", fallback="")
    src_key = ""
    if wp and os.path.isfile(wp):
        st = os.stat(wp)
        src_key = "%s|%d" % (wp, st.st_mtime)
        if not os.access(bg, os.W_OK):
            src_key = prev_src
        if src_key != prev_src and os.access(bg, os.W_OK):
            try:
                from PIL import Image
                img = Image.open(wp)
                img.seek(0)
                img = img.convert("RGB")
                img.thumbnail((2560, 1600))
                with open(bg, "wb") as f:      # in place: the theme folder itself is root-owned
                    img.save(f, format="PNG")
            except Exception as e:  # noqa: BLE001
                print("bevelctl: login wallpaper not updated: %s" % e, file=sys.stderr)
                src_key = prev_src
    lines = ["[General]", "background=background.png", "wallpaperSource=%s" % src_key,
             "dim=%s" % s.get("login", {}).get("dim", 0.55),
             "barFont=%s" % s["bar"].get("font", "JetBrains Mono")]
    # the big name on the login banner: "Arch" + "Linux", "CachyOS" + "Linux", "EndeavourOS"…
    full = distro_info(s)["fullName"].replace("\n", " ")
    m = re.match(r"^(.*?)\s+((?:GNU/)?Linux)$", full)
    lines += ["osName=%s" % (m.group(1) if m else full), "osSub=%s" % (m.group(2) if m else "none")]
    for k in ("face", "face2", "hi", "lo", "dark", "base", "text", "textDim", "accent", "accent2", "onAccent"):
        lines.append("%s=%s" % (k, p[k]))
    text = "\n".join(lines) + "\n"
    try:
        with open(conf) as f:
            if f.read() == text:
                return
    except OSError:
        pass
    with open(conf, "w") as f:      # in place: the theme folder itself is root-owned
        f.write(text)


def run(cmd, **kw):
    kw.setdefault("timeout", 10)
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except (OSError, subprocess.SubprocessError):
        return None


def file_sig(path):
    try:
        with open(path, "rb") as f:
            return hash(f.read())
    except OSError:
        return None


WATCH = {
    "hypr": [os.path.join(HOME, ".config", "hypr", "bevel_generated.lua")],
    "kitty": [os.path.join(HOME, ".config", "kitty", "bevel-colors.conf")],
    "idle": [os.path.join(HOME, ".config", "hypr", "hypridle.conf")],
    "kde": [os.path.join(HOME, ".config", "kdeglobals"), os.path.join(HOME, ".config", "qt6ct", "colors", "bevel.conf")],
}


def reload_apps(changed):
    if "kitty" in changed:
        run(["pkill", "-USR1", "-x", "kitty"])                   # kitty re-reads its config
    if "idle" in changed and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hypridle"):
        run(["pkill", "-x", "hypridle"])
        subprocess.Popen(["hypridle"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if "hypr" in changed:
        run(["hyprctl", "reload"])
    if "kde" in changed:
        run(["dbus-send", "--session", "--type=signal", "/KGlobalSettings",
             "org.kde.KGlobalSettings.notifyChange", "int32:0", "int32:0"])
        dark = "prefer-dark" if load_settings()["colors"].get("darkPanels") else "prefer-light"
        run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", dark])


# What a wallpaper/colour change rewrites, in two rounds. The quick round is what you see right away
# (the shell's colours, the wallpaper, Hyprland borders, kitty); it runs before the command returns.
# The rest (GTK theme pictures, pointers, Firefox, other apps, login screen…) runs right after in a
# background process, so clicking through wallpapers never waits for it.
def _quick_writers():
    return (write_quickshell, write_kitty, write_hypr)


def _slow_writers():
    return (write_hypridle, write_qt, write_gtk, write_sddm, write_fastfetch, write_gtk_theme, write_firefox, write_apps,
            write_qs_icons, write_cursor, lambda s, p: write_gtk_settings(s))


def apply(quiet=False, split=False):
    """Regenerate everything. split=True: the quick round now, the rest in the background
    (set BEVEL_SYNC=1 to always do it all in one go, e.g. in scripts)."""
    import fcntl
    os.makedirs(CACHE, exist_ok=True)
    split = split and not os.environ.get("BEVEL_SYNC")
    with open(os.path.join(CACHE, "apply.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        _apply(quiet, "quick" if split else "all")
        if split:
            gen = _apply_gen(+1)
    if split:
        subprocess.Popen(SELF + ["apply-rest", str(gen)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def _apply_gen(step=0):
    f = os.path.join(CACHE, "apply.gen")
    try:
        n = int(open(f).read().strip() or 0)
    except (OSError, ValueError):
        n = 0
    if step:
        n += step
        write_atomic(f, str(n))
    return n


def apply_rest(gen):
    """The background round. Several quick changes in a row: only the newest one does it."""
    import fcntl
    time.sleep(0.25)                                     # let a burst of clicks settle
    with open(os.path.join(CACHE, "apply-rest.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if _apply_gen() != gen:
            return 0                                     # a newer change will run after us
        _apply(True, "rest")
    return 0


def _apply(quiet=False, phase="all"):
    s = load_settings()
    p = build_palette(s)
    before = {k: [file_sig(f) for f in fs] for k, fs in WATCH.items()}
    before["_theme"] = file_sig(os.path.join(THEME_DIR, ".bevel-palette"))
    writers = {"quick": _quick_writers(), "rest": _slow_writers()}.get(phase, _quick_writers() + _slow_writers())
    for writer in writers:
        try:
            writer(s, p)
        except Exception as e:  # noqa: BLE001 — one broken target must not stop the rest
            print("bevelctl: %s failed: %s" % (writer.__name__, e), file=sys.stderr)
            log("ERROR %s: %s" % (writer.__name__, e))
    if phase != "rest":
        try:
            sync_wallpaper(s)
        except Exception as e:  # noqa: BLE001
            log("ERROR sync_wallpaper: %s" % e)
    theme_before = before.get("_theme")
    changed = {k for k, fs in WATCH.items() if k in before and [file_sig(f) for f in fs] != before[k]}
    reload_apps(changed)
    # a Hyprland reload resets the pointer; the pointer pictures themselves are made in the second round
    if phase != "quick" or "hypr" in changed:
        try:
            hypr_cursor(s)
        except Exception as e:  # noqa: BLE001
            log("ERROR hypr_cursor: %s" % e)
    if phase == "quick":
        if not quiet:
            print("bevel: applied (accent %s, hue %d°)" % (p["accent"], p["seedHue"]))
        return
    palette_changed = file_sig(os.path.join(THEME_DIR, ".bevel-palette")) != theme_before or "kde" in changed
    # apps that only read their colours at start-up: restart them in the background
    a = s.get("apps", {})
    which = [n for n, k in (("dolphin", "restartDolphin"), ("firefox", "restartFirefox")) if a.get(k, n == "dolphin")]
    if palette_changed and which and any(_pids(n) for n in which + (["firefox-bin"] if "firefox" in which else [])):
        subprocess.Popen(SELF + ["restart-apps"] + which,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if not quiet:
        print("bevel: applied (accent %s, hue %d°)" % (p["accent"], p["seedHue"]))


# ---------------------------------------------------------------- wallpaper
def wall_cmd():
    for c in ("awww", "swww"):
        if shutil.which(c):
            return c
    return None


def set_wallpaper(path, s, wait=False):
    path = expand(path)
    cmd = wall_cmd()
    if not cmd or not os.path.isfile(path):
        return False
    if wait:
        for _ in range(50):
            r = run([cmd, "query"])
            if r and r.returncode == 0:
                break
            time.sleep(0.1)
    trans = s["wallpaper"].get("transition", "grow")
    args = [cmd, "img", path, "--transition-type", trans, "--transition-fps", "60", "--transition-duration", "0.8"]
    if trans == "grow":
        args += ["--transition-pos", "top-left"]
    if trans == "none":
        args = [cmd, "img", path, "--transition-type", "none"]
    if wait:
        r = run(args)
        ok = bool(r and r.returncode == 0)
    else:
        # don't wait: the wallpaper tool decodes and scales the picture itself (slow for big ones),
        # meanwhile the colours already change
        subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        ok = True
    if ok:
        try:
            os.makedirs(CACHE, exist_ok=True)
            with open(os.path.join(CACHE, "wall.shown"), "w") as f:
                f.write(path)
        except OSError:
            pass
    return ok


def sync_wallpaper(s):
    """Hyprland: show the right picture under the shell (it changes when you switch to/from live)."""
    if not os.environ.get("WAYLAND_DISPLAY") or not wall_cmd():
        return
    want = wall_path(s)
    try:
        shown = open(os.path.join(CACHE, "wall.shown")).read().strip()
    except OSError:
        shown = ""
    if want and want != shown and os.path.isfile(want):
        s2 = json.loads(json.dumps(s))
        if is_live(s):
            s2["wallpaper"]["transition"] = "none"
        set_wallpaper(want, s2)





IMAGE_EXT = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp")


def list_wallpapers(s):
    folder = expand(s["wallpaper"].get("folder", "~/Pictures/Wallpapers"))
    out = []
    if s["wallpaper"].get("subfolders", True):
        for root, dirs, files in os.walk(folder, followlinks=True):
            dirs[:] = sorted(d for d in dirs if not d.startswith("."))
            if root[len(folder):].count(os.sep) > 3:
                dirs[:] = []
            out += [os.path.join(root, f) for f in files if f.lower().endswith(IMAGE_EXT) and not f.startswith(".")]
    else:
        try:
            out = [os.path.join(folder, f) for f in os.listdir(folder) if f.lower().endswith(IMAGE_EXT) and not f.startswith(".")]
        except OSError:
            out = []
    return sorted(out, key=lambda x: x.lower())


def thumbnails(s, make=True):
    """[{path, thumb, name, folder, mtime, w, h}] — small cached PNGs so the settings grid loads instantly."""
    import hashlib
    tdir = os.path.join(CACHE, "thumbs")
    os.makedirs(tdir, exist_ok=True)
    out = []
    try:
        from PIL import Image
    except ImportError:
        Image = None
    base = expand(s["wallpaper"].get("folder", "~/Pictures/Wallpapers")).rstrip("/")
    sizes_file = os.path.join(tdir, "sizes.json")
    try:
        sizes = json.load(open(sizes_file))
    except (OSError, ValueError):
        sizes = {}
    sizes_changed = False
    for w in list_wallpapers(s):
        try:
            st = os.stat(w)
        except OSError:
            continue
        key = hashlib.sha1(("%s|%d|%d" % (w, st.st_mtime, st.st_size)).encode()).hexdigest()[:16]
        t = os.path.join(tdir, key + ".png")
        pending = False
        if not make and not os.path.exists(t):
            pending = True
        elif not os.path.exists(t) and Image is not None:
            try:
                img = Image.open(w)
                img.seek(0)
                img = img.convert("RGB")
                sizes[key] = list(img.size)
                sizes_changed = True
                img.thumbnail((320, 200))
                img.save(t)
            except Exception:  # noqa: BLE001
                t = w
        rel = os.path.relpath(os.path.dirname(w), base) if w.startswith(base + "/") else os.path.dirname(w)
        wh = sizes.get(key, [0, 0])
        out.append({"path": w, "thumb": "" if pending else (t if os.path.exists(t) else w), "pending": pending, "name": os.path.splitext(os.path.basename(w))[0],
                    "folder": "" if rel == "." else rel, "mtime": int(st.st_mtime), "w": wh[0], "h": wh[1]})
    if sizes_changed:
        write_atomic(sizes_file, json.dumps(sizes))
    return out


def system_info():
    def cmd(c):
        r = run(c)
        return r.stdout.strip() if r and r.returncode == 0 else ""
    info = {"kernel": os.uname().release, "host": os.uname().nodename}
    try:
        info["hyprland"] = json.loads(cmd(["hyprctl", "version", "-j"]) or "{}").get("tag", "")
    except ValueError:
        info["hyprland"] = ""
    info["quickshell"] = (cmd(["qs", "--version"]).splitlines() or [""])[0].replace("quickshell", "").strip()
    info["version"] = bevel_version()
    info["editor"] = (find_editor(load_settings()) or {}).get("name", "")
    try:
        with open("/proc/uptime") as f:
            up = int(float(f.read().split()[0]))
        info["uptime"] = "%dh %02dm" % (up // 3600, up % 3600 // 60)
    except (OSError, ValueError):
        info["uptime"] = ""
    try:
        with open("/proc/cpuinfo") as f:
            for line in f:
                if line.startswith("model name"):
                    info["cpu"] = line.split(":", 1)[1].strip()
                    break
    except OSError:
        pass
    info["login"] = os.path.isdir(SDDM_DIR)
    # tools some features need (Settings shows a hint when one is missing)
    info["retroIcons"] = retro_icons_installed()
    info["missing"] = [c for c in ("hypridle", "hyprlock", "hyprsunset", "bluetoothctl", "nmcli")
                       if not shutil.which(c)]
    return info


# ---------------------------------------------------------------- version and updates
REPO_URL = "https://github.com/MordoMordeczek/bevel.git"
SOURCE_FILE = os.path.join(CFG, "install-source")


def bevel_version():
    try:
        with open(os.path.join(SHARE, "VERSION")) as f:
            return f.read().strip() or "dev"
    except OSError:
        return "dev"


def install_source():
    """The folder ./install.sh was run from (Setup writes it down), or ''."""
    try:
        with open(SOURCE_FILE) as f:
            d = f.read().strip()
        return d if os.path.isfile(os.path.join(d, "install.sh")) else ""
    except OSError:
        return ""


def _git(src, *a, timeout=60, ask=False):
    env = dict(os.environ, LC_ALL="C")
    if not ask:
        env["GIT_TERMINAL_PROMPT"] = "0"          # from the shell: never sit waiting for a password
    try:
        return subprocess.run(["git", "-C", src] + list(a), capture_output=True, text=True, timeout=timeout, env=env)
    except (OSError, subprocess.SubprocessError) as e:
        return subprocess.CompletedProcess(a, 1, "", str(e))


def update_status(ask=False):
    """{version, source, git, behind, log, dirty, error} — what `bevelctl update --check` reports."""
    st = {"version": bevel_version(), "source": install_source(), "git": False, "behind": 0, "log": [], "dirty": False, "error": ""}
    src = st["source"]
    if not src or not os.path.isdir(os.path.join(src, ".git")) or not shutil.which("git"):
        return st
    st["git"] = True
    r = _git(src, "fetch", "--quiet", timeout=None if ask else 60, ask=ask)
    if r.returncode != 0:
        st["error"] = (r.stderr.strip().splitlines() or ["git fetch failed"])[-1]
        return st
    r = _git(src, "rev-list", "--count", "HEAD..@{u}")
    st["behind"] = int(r.stdout.strip() or 0) if r.returncode == 0 else 0
    if st["behind"]:
        r = _git(src, "log", "--format=%s", "HEAD..@{u}")
        st["log"] = r.stdout.strip().splitlines()[:20]
    st["dirty"] = bool(_git(src, "status", "--porcelain", "--untracked-files=no").stdout.strip())
    return st


def update(args):
    """bevelctl update [--check] [--json]: get the newest Bevel from git and install it over this one
    (your settings, wallpapers and user.lua stay; your choices from Setup are kept)."""
    st = update_status(ask="--json" not in args and sys.stdin.isatty())
    if "--json" in args:
        print(json.dumps(st))
        return 0
    print("Bevel %s" % st["version"])
    if not st["git"]:
        print("This Bevel wasn't installed from a git clone, so it can't update itself.")
        print("Get it once with git, then updates are one command:\n")
        print("    git clone %s ~/bevel" % REPO_URL)
        print("    cd ~/bevel && ./install.sh --update\n")
        return 1
    if st["error"]:
        print("Couldn't reach GitHub: %s" % st["error"])
        return 1
    if not st["behind"]:
        print("You have the newest version. (%s)" % st["source"])
        return 0
    print("%d new change%s:" % (st["behind"], "" if st["behind"] == 1 else "s"))
    for line in st["log"]:
        print("  • " + line)
    if "--check" in args:
        return 0
    if st["dirty"]:
        print("\nYou changed files in %s, so git can't update it safely." % st["source"])
        print("Keep your own tweaks in ~/.config/hypr/user.lua instead, then: git -C %s stash" % st["source"])
        return 1
    print()
    r = subprocess.run(["git", "-C", st["source"], "pull", "--ff-only"])
    if r.returncode != 0:
        print("git pull failed; nothing was changed.")
        return 1
    print("\nInstalling the new version…")
    os.execvp("bash", ["bash", os.path.join(st["source"], "install.sh"), "--update"])


# ---------------------------------------------------------------- open configs in an editor
EDITORS = [  # (command, name, opens folders)
    ("code", "VS Code", True), ("code-oss", "VS Code", True), ("codium", "VSCodium", True), ("vscodium", "VSCodium", True),
    ("zeditor", "Zed", True), ("zed", "Zed", True), ("kate", "Kate", True), ("gnome-text-editor", "Text Editor", False),
    ("mousepad", "Mousepad", False), ("gedit", "gedit", False), ("xed", "Xed", False),
]
TERM_EDITORS = ("nvim", "vim", "helix", "hx", "micro", "nano", "vi")


def find_editor(s):
    """The editor configs open in: Settings → About → "Open with", or the first one installed."""
    want = (s.get("about", {}) or {}).get("editor", "auto")
    for c, name, folders in EDITORS:
        if (want in ("auto", c)) and shutil.which(c):
            return {"cmd": [c], "name": name, "folders": folders}
    env = (os.environ.get("VISUAL") or os.environ.get("EDITOR") or "").split()
    for c in ([env[0]] if env else []) + list(TERM_EDITORS):
        if shutil.which(c) and (want in ("auto", c, "terminal")):
            return {"cmd": ["kitty", "--class", "bevel-editor", c], "name": os.path.basename(c), "folders": c in ("nvim", "vim", "hx", "helix")}
    return None


def edit_target(what):
    """What `bevelctl edit WHAT` opens. user.lua / user.conf are made if they don't exist yet."""
    hypr = os.path.join(HOME, ".config", "hypr")
    t = {
        "settings": SETTINGS,
        "user": os.path.join(hypr, "user.lua"),
        "hypr": hypr,
        "keybinds": os.path.join(hypr, "bevel_keybinds.lua"),
        "shell": os.path.join(HOME, ".config", "quickshell", "bevel"),
        "kitty": os.path.join(HOME, ".config", "kitty", "user.conf"),
        "folder": CFG,
    }.get(what)
    if t and what == "user" and not os.path.exists(t):
        os.makedirs(hypr, exist_ok=True)
        with open(t, "w") as f:
            f.write("-- Your own Hyprland tweaks. Bevel never overwrites this file; it is loaded last.\n")
    if t and what == "kitty" and not os.path.exists(t):
        os.makedirs(os.path.dirname(t), exist_ok=True)
        with open(t, "w") as f:
            f.write("# your own kitty tweaks (Bevel never overwrites this file)\n")
    return t


def edit(args):
    what = args[0] if args else "settings"
    t = edit_target(what)
    if not t:
        print("bevelctl edit settings|user|hypr|keybinds|shell|kitty|folder", file=sys.stderr)
        return 1
    ed = find_editor(load_settings())
    if what == "folder" or ed is None or (os.path.isdir(t) and not ed["folders"]):
        cmd = ["xdg-open", t]                       # the file manager (or whatever opens the file)
    else:
        cmd = ed["cmd"] + [t]
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as e:
        print("could not open %s: %s" % (t, e), file=sys.stderr)
        return 1
    return 0


# ---------------------------------------------------------------- screenshots
def screenshot(mode):
    """Capture the whole screen FIRST, then crop. That way the selection overlay,
    fading pop-ups and the focused-window border never end up in the picture."""
    d = os.path.join(HOME, "Pictures", "Screenshots")
    os.makedirs(d, exist_ok=True)
    f = os.path.join(d, time.strftime("shot_%Y-%m-%d_%H-%M-%S.png"))
    os.makedirs(CACHE, exist_ok=True)
    full = os.path.join(CACHE, "shot-full.png")
    r = run(["grim", full])
    if not r or r.returncode != 0:
        run(["notify-send", "-a", "Screenshot", "Screenshot failed", (r.stderr if r else "grim not found")])
        return

    box = None  # logical x, y, w, h
    if mode == "region":
        try:
            sl = subprocess.run(["slurp", "-f", "%x %y %w %h"], capture_output=True, text=True)
        except OSError:
            sl = None
        if not sl or sl.returncode != 0 or not sl.stdout.strip():
            return  # cancelled with Esc
        box = [int(float(v)) for v in sl.stdout.split()]
    elif mode == "window":
        try:
            w = json.loads(run(["hyprctl", "-j", "activewindow"]).stdout)
            box = [w["at"][0], w["at"][1], w["size"][0], w["size"][1]]
        except (AttributeError, ValueError, KeyError, TypeError):
            box = None

    if box and box[2] > 0 and box[3] > 0:
        try:
            from PIL import Image
            mons = monitors()
            minx = min((m["x"] for m in mons), default=0)
            miny = min((m["y"] for m in mons), default=0)
            img = Image.open(full)
            # grim renders the whole layout at the highest monitor scale
            sc = max((m.get("scale", 1) for m in mons), default=1)
            x0 = round((box[0] - minx) * sc)
            y0 = round((box[1] - miny) * sc)
            crop = img.crop((x0, y0, x0 + round(box[2] * sc), y0 + round(box[3] * sc)))
            crop.save(f)
        except Exception as e:  # noqa: BLE001
            run(["notify-send", "-a", "Screenshot", "Screenshot failed", str(e)])
            return
    else:
        shutil.move(full, f)

    with open(f, "rb") as fh:
        try:
            subprocess.run(["wl-copy", "--type", "image/png"], stdin=fh, timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass
    run(["notify-send", "-a", "Screenshot", "-i", f, "Screenshot saved", "Copied to clipboard · " + os.path.basename(f)])


# ---------------------------------------------------------------- brightness
def backlights():
    """Real panel controls first: 'raw'/'platform' devices (amdgpu_bl*, nvidia_wmi_ec_backlight,
    intel_backlight). 'firmware' ones (acpi_video*) are often dead on hybrid laptops, so they
    are only used when nothing better exists."""
    base = "/sys/class/backlight"
    try:
        devs = sorted(os.listdir(base))
    except OSError:
        return []
    def kind(d):
        try:
            with open(os.path.join(base, d, "type")) as f:
                return f.read().strip()
        except OSError:
            return "firmware"
    native = [d for d in devs if kind(d) in ("raw", "platform")]
    return native or devs


def brightness(action, quiet=False):
    """Laptops with hybrid graphics (AMD iGPU + NVIDIA) often expose two or three
    backlight devices and only one of them really drives the panel, so change all."""
    devs = backlights()
    if action == "get":
        best = None
        for dv in devs:
            try:
                with open("/sys/class/backlight/%s/brightness" % dv) as a, open("/sys/class/backlight/%s/max_brightness" % dv) as b:
                    # same curve as `brightnessctl -e4`, so 50% here = 50% on the slider
                    pct = (int(a.read()) / max(1, int(b.read()))) ** 0.25 * 100
                    best = pct if best is None else max(best, pct)
            except (OSError, ValueError):
                pass
        print(round(best if best is not None else 0))
        return
    step = {"up": "5%+", "down": "5%-"}.get(action, action)
    if not devs:
        run(["brightnessctl", "-e4", "-n2", "set", step])
    for dv in devs:
        run(["brightnessctl", "-d", dv, "-e4", "-n2", "set", step])
    if not quiet:
        run(["qs", "-c", "bevel", "ipc", "call", "osd", "brightness"])


# ---------------------------------------------------------------- control panel helpers
def _nm_split(line):
    """nmcli -t output: fields split on ':' with '\\:' escaped."""
    out, cur, esc = [], "", False
    for ch in line:
        if esc:
            cur += ch
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            out.append(cur)
            cur = ""
        else:
            cur += ch
    out.append(cur)
    return out


def _out(cmd, timeout=6):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def cp_status():
    st = {"wifi": None, "wifiDevice": "", "net": "", "netType": "", "ip": "", "airplane": False,
          "bt": None, "btDevices": [], "nightlight": False, "profile": "", "profiles": [], "caffeine": False}
    if shutil.which("nmcli"):
        st["wifi"] = _out(["nmcli", "radio", "wifi"]).strip() == "enabled"
        for line in _out(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device"]).splitlines():
            f = _nm_split(line)
            if len(f) < 4:
                continue
            if f[1] == "wifi" and not st["wifiDevice"]:
                st["wifiDevice"] = f[0]
            if f[2] == "connected" and f[1] in ("wifi", "ethernet") and (not st["net"] or f[1] == "ethernet"):
                st["net"], st["netType"] = f[3], f[1]
                ip = _out(["nmcli", "-t", "-g", "IP4.ADDRESS", "device", "show", f[0]]).strip().split("\n")[0]
                st["ip"] = ip.split("/")[0]
    rf = _out(["rfkill", "-n", "-o", "TYPE,SOFT"]) if shutil.which("rfkill") else ""
    rows = [l.split() for l in rf.splitlines() if l.strip()]
    if rows:
        st["airplane"] = all(r[-1] == "blocked" for r in rows)
    if shutil.which("bluetoothctl"):
        show = _out(["bluetoothctl", "show"], timeout=3)
        if "Controller" in show:
            st["bt"] = "Powered: yes" in show
            paired = _out(["bluetoothctl", "devices", "Paired"], timeout=3) or _out(["bluetoothctl", "paired-devices"], timeout=3)
            for line in paired.splitlines():
                parts = line.split(" ", 2)
                if len(parts) < 3 or parts[0] != "Device":
                    continue
                info = _out(["bluetoothctl", "info", parts[1]], timeout=3) if st["bt"] else ""
                bat = re.search(r"Battery Percentage: \S+ \((\d+)\)", info)
                icon = re.search(r"Icon: (\S+)", info)
                st["btDevices"].append({"mac": parts[1], "name": parts[2], "connected": "Connected: yes" in info,
                                        "battery": int(bat.group(1)) if bat else -1, "icon": icon.group(1) if icon else ""})
    st["nightlight"] = bool(_pids("hyprsunset"))
    if shutil.which("powerprofilesctl"):
        st["profile"] = _out(["powerprofilesctl", "get"]).strip()
        st["profiles"] = re.findall(r"^\s*\*?\s*([a-z-]+):\s*$", _out(["powerprofilesctl", "list"]), re.M)
    st["caffeine"] = os.path.exists(os.path.join(CACHE, "caffeine.pid")) and _pid_alive(os.path.join(CACHE, "caffeine.pid"))
    return st


def _pid_alive(pidfile):
    try:
        pid = int(open(pidfile).read().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        return False


def cp_wifi_scan(rescan=True):
    nets, seen = [], {}
    known = set(_nm_split(l)[0] for l in _out(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"]).splitlines()
                if l.endswith(":802-11-wireless"))
    out = _out(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,BARS", "device", "wifi", "list", "--rescan",
                "yes" if rescan else "no"], timeout=20)
    for line in out.splitlines():
        f = _nm_split(line)
        if len(f) < 4 or not f[1]:
            continue
        ssid = f[1]
        n = {"ssid": ssid, "active": f[0].strip() == "*", "signal": int(f[2] or 0),
             "secure": f[3] not in ("", "--"), "security": f[3], "known": ssid in known}
        if ssid in seen:
            old = nets[seen[ssid]]
            old["active"] = old["active"] or n["active"]
            old["signal"] = max(old["signal"], n["signal"])
            continue
        seen[ssid] = len(nets)
        nets.append(n)
    nets.sort(key=lambda n: (not n["active"], not n["known"], -n["signal"]))
    return nets


def cp_sysinfo():
    info = {}
    try:
        mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo") if ":" in l}
        info["memTotal"] = mem.get("MemTotal", 0) * 1024
        info["memUsed"] = (mem.get("MemTotal", 0) - mem.get("MemAvailable", 0)) * 1024
        info["swapTotal"] = mem.get("SwapTotal", 0) * 1024
        info["swapUsed"] = (mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)) * 1024
    except OSError:
        pass
    try:
        du = shutil.disk_usage(HOME)
        info["diskTotal"], info["diskUsed"] = du.total, du.used
    except OSError:
        pass
    try:
        info["uptime"] = int(float(open("/proc/uptime").read().split()[0]))
    except (OSError, ValueError):
        pass
    try:
        info["load"] = open("/proc/loadavg").read().split()[:3]
    except OSError:
        pass
    u = os.uname()
    info["kernel"], info["host"] = u.release, u.nodename
    info["distro"] = distro_name()
    temps = []
    for z in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            temps.append(int(open(z).read()) / 1000)
        except (OSError, ValueError):
            pass
    info["temp"] = round(max(temps)) if temps else None
    return info


def fetch_info():
    """fastfetch-style facts for the desktop widget (the slow parts are cached for a day)."""
    cache = os.path.join(CACHE, "fetch.json")
    try:
        st = os.stat(cache)
        if time.time() - st.st_mtime < 86400:
            info = json.load(open(cache))
        else:
            info = None
    except (OSError, ValueError):
        info = None
    if info is None:
        info = {}

        def rd(path):
            try:
                return open(path).read().strip()
            except OSError:
                return ""
        vendor, prod, ver = rd("/sys/devices/virtual/dmi/id/sys_vendor"), rd("/sys/devices/virtual/dmi/id/product_name"), \
            rd("/sys/devices/virtual/dmi/id/product_version")
        model = ver if vendor.lower().startswith("lenovo") and ver and "none" not in ver.lower() else prod
        info["host"] = " ".join(x for x in (vendor if vendor.lower() not in model.lower() else "", model) if x).strip()
        try:
            for line in open("/proc/cpuinfo"):
                if line.startswith("model name"):
                    cpu = line.split(":", 1)[1].strip()
                    cpu = re.sub(r"\((R|TM)\)|CPU|Processor|\d+-Core|with Radeon.*", "", cpu)
                    info["cpu"] = re.sub(r"\s+", " ", cpu).strip() + " (%d)" % os.cpu_count()
                    break
        except OSError:
            pass
        gpus = []
        for line in _out(["lspci"]).splitlines():
            if re.search(r"VGA compatible|3D controller|Display controller", line):
                g = line.split(": ", 1)[-1]
                m = re.search(r"\[([^\]]*(GeForce|Radeon|Arc|Iris|UHD|RTX|GTX)[^\]]*)\]", g)
                g = m.group(1) if m else re.sub(r"Corporation|\(rev .*\)|Advanced Micro Devices, Inc\.", "", g)
                gpus.append(re.sub(r"\s+", " ", g).strip())
        info["gpu"] = gpus
        n = _out(["sh", "-c", "pacman -Qq 2>/dev/null | wc -l"]).strip()
        info["packages"] = (n + " (pacman)") if n and n != "0" else ""
        fp = _out(["sh", "-c", "flatpak list --app 2>/dev/null | wc -l"]).strip()
        if fp and fp != "0":
            info["packages"] += ", %s (flatpak)" % fp
        info["kernel"] = os.uname().release
        info["os"] = distro_name()
        try:
            kv = dict(ln.rstrip("\n").split("=", 1) for ln in open("/etc/os-release") if "=" in ln)
            info["osPretty"] = kv.get("PRETTY_NAME", info["os"]).strip('"')
        except OSError:
            info["osPretty"] = info["os"]
        write_atomic(cache, json.dumps(info))
    s = load_settings()
    info["user"] = os.environ.get("USER", "") + "@" + os.uname().nodename
    info["shell"] = os.path.basename(os.environ.get("SHELL", "sh"))
    info["wm"] = "Hyprland" if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") else (os.environ.get("XDG_CURRENT_DESKTOP") or "")
    info["terminal"] = "kitty" if shutil.which("kitty") else ""
    info["font"] = s["style"].get("font", "Pixelify Sans")
    info["theme"] = "Bevel (%s)" % (live_cfg(s)["kind"] if is_live(s) else os.path.basename(expand(s["wallpaper"]["path"])) or "custom")
    try:
        mons = json.loads(_out(["hyprctl", "monitors", "-j"]) or "[]")
        info["display"] = ", ".join("%dx%d@%d" % (m["width"], m["height"], round(m.get("refreshRate", 60))) for m in mons)
    except ValueError:
        info["display"] = ""
    return info


def cp_timezones(zones):
    """{zone: offset in minutes from UTC, right now} for the world clock widget."""
    out = {}
    try:
        from zoneinfo import ZoneInfo
        import datetime
        now = datetime.datetime.now(datetime.timezone.utc)
        for z in zones:
            try:
                off = now.astimezone(ZoneInfo(z)).utcoffset()
                out[z] = int(off.total_seconds() // 60) if off is not None else 0
            except Exception:  # noqa: BLE001
                out[z] = None
    except ImportError:
        pass
    return out


def cp_rss(url, limit=20):
    """Headlines from an RSS or Atom feed: [{title, link, date}]."""
    import urllib.request
    import xml.etree.ElementTree as ET
    req = urllib.request.Request(url, headers={"User-Agent": "Bevel/1.0 (desktop widget)"})
    with urllib.request.urlopen(req, timeout=15) as r:
        data = r.read()
    root = ET.fromstring(data)
    items = []
    for it in root.iter():
        tag = it.tag.split("}")[-1]
        if tag not in ("item", "entry"):
            continue
        title, link, date = "", "", ""
        for c in it:
            ct = c.tag.split("}")[-1]
            if ct == "title":
                title = (c.text or "").strip()
            elif ct == "link":
                link = (c.get("href") or c.text or "").strip() or link
            elif ct in ("pubDate", "updated", "published") and not date:
                date = (c.text or "").strip()
        if title:
            items.append({"title": re.sub(r"\s+", " ", title), "link": link, "date": date})
        if len(items) >= limit:
            break
    return items


def cp_trash(action="count"):
    files = os.path.join(HOME, ".local", "share", "Trash", "files")
    info = os.path.join(HOME, ".local", "share", "Trash", "info")
    if action == "empty":
        if shutil.which("gio") and run(["gio", "trash", "--empty"]) is not None:
            pass
        for folder in (files, info):
            try:
                for n in os.listdir(folder):
                    pth = os.path.join(folder, n)
                    if os.path.isdir(pth) and not os.path.islink(pth):
                        shutil.rmtree(pth, ignore_errors=True)
                    else:
                        try:
                            os.remove(pth)
                        except OSError:
                            pass
            except OSError:
                pass
    try:
        return len(os.listdir(files))
    except OSError:
        return 0


def cava_widget_conf(bars=24):
    """A cava config that prints bar heights (0–100) for the visualizer widget."""
    path = os.path.join(CACHE, "cava-widget.conf")
    os.makedirs(CACHE, exist_ok=True)
    write_atomic(path, "[general]\nbars = %d\nframerate = 30\nsensitivity = 100\n\n[input]\nmethod = pulse\nsource = auto\n\n"
                       "[output]\nmethod = raw\nraw_target = /dev/stdout\ndata_format = ascii\nascii_max_range = 100\n"
                       "bar_delimiter = 59\nframe_delimiter = 10\n" % max(4, min(64, int(bars))))
    return path


# ---------------------------------------------------------------- themes (.bevel files)
THEME_DIRS = (os.path.join(SHARE, "themes"), os.path.join(HOME, "Bevel Themes"))
THEME_EXPORT_DIR = os.path.join(HOME, "Bevel Themes")
# what a theme carries: the look, not your personal setup (folders, favourites, touchpad, lock…)
THEME_KEYS = ("colors.", "style.", "bar.", "windows.gapsIn", "windows.gapsOut", "windows.border", "windows.rounding",
              "windows.blur", "windows.shadow", "windows.opacity", "wallpaper.mode", "wallpaper.transition",
              "wallpaper.live.", "wallpaper.effect.", "cursor.", "launcher.", "power.style", "widgets.style", "widgets.corner", "widgets.arrange",
              "widgets.cols", "widgets.cell", "widgets.gap", "widgets.opacity", "widgets.list", "widgets.enabled",
              "widgets.asciiText", "widgets.asciiStyle",
              "fun.btw", "fun.btwText", "fun.screensaver", "fun.pet", "login.dim", "terminal.opacity")


# bar settings that are personal rather than part of a look: importing a theme keeps them
THEME_KEEP = ("bar.clockFormat", "bar.clockSeconds", "bar.showDate", "bar.workspaces")


def _flatten(d, prefix=""):
    out = {}
    for k, v in d.items():
        key = prefix + k
        if isinstance(v, dict):
            out.update(_flatten(v, key + "."))
        else:
            out[key] = v
    return out


def _theme_slug(name):
    return re.sub(r"[^A-Za-z0-9._ -]+", "", name).strip().replace(" ", "-") or "theme"


def theme_export(name, author="", path=None, with_wallpaper=True):
    import base64
    s = load_settings()
    flat = _flatten(s)
    settings = {k: v for k, v in flat.items() if k.startswith(THEME_KEYS)}
    p = build_palette(s)
    th = {"bevelTheme": 1, "name": name, "author": author or os.environ.get("USER", ""),
          "created": time.strftime("%Y-%m-%d"), "settings": settings,
          "swatch": [p["accent"], p["accent2"], p["face"], p["dark"], p["termBg"]]}
    wall = wall_path(s)
    try:
        from PIL import Image
        if wall and os.path.isfile(wall):
            img = Image.open(wall)
            img.seek(0)
            img = img.convert("RGB")
            img.thumbnail((320, 180))
            buf = io.BytesIO()
            img.save(buf, "PNG")
            th["preview"] = base64.b64encode(buf.getvalue()).decode()
    except Exception:  # noqa: BLE001
        pass
    if with_wallpaper and not is_live(s):
        src = expand(s["wallpaper"]["path"])
        if src and os.path.isfile(src) and os.path.getsize(src) < 25 * 1024 * 1024:
            with open(src, "rb") as f:
                th["wallpaper"] = {"filename": os.path.basename(src), "data": base64.b64encode(f.read()).decode()}
    os.makedirs(THEME_EXPORT_DIR, exist_ok=True)
    out = path or os.path.join(THEME_EXPORT_DIR, _theme_slug(name) + ".bevel")
    with open(out, "w") as f:
        json.dump(th, f)
    return out


def theme_read(path):
    with open(path) as f:
        th = json.load(f)
    if not isinstance(th, dict) or th.get("bevelTheme") != 1 or not isinstance(th.get("settings"), dict):
        raise ValueError("not a Bevel theme")
    # only known, harmless keys: a theme file can change the look and nothing else
    th["settings"] = {k: v for k, v in th["settings"].items() if isinstance(k, str) and k.startswith(THEME_KEYS)}
    return th


def theme_import(path, keep=True, undo=True):
    """Apply a .bevel theme (and keep a copy in your theme list)."""
    import base64
    th = theme_read(path)
    if undo:
        try:
            os.makedirs(CACHE, exist_ok=True)
            theme_export("Before " + th.get("name", "theme"), path=os.path.join(CACHE, "undo.bevel"), with_wallpaper=False)
            with open(os.path.join(CACHE, "undo.path"), "w") as f:
                f.write(load_settings()["wallpaper"]["path"])
        except Exception as e:  # noqa: BLE001
            log("theme undo save failed: %s" % e)
    ch = dict(th["settings"])
    wp = th.get("wallpaper")
    if isinstance(wp, dict) and wp.get("data"):
        folder = os.path.join(expand(load_settings()["wallpaper"].get("folder", "~/Pictures/Wallpapers")), "Bevel themes")
        os.makedirs(folder, exist_ok=True)
        fname = os.path.basename(wp.get("filename") or "wallpaper.png")
        if not fname.lower().endswith(IMAGE_EXT):
            fname += ".png"
        dest = os.path.join(folder, _theme_slug(th.get("name", "theme")) + "-" + fname)
        with open(dest, "wb") as f:
            f.write(base64.b64decode(wp["data"]))
        ch["wallpaper.path"] = dest
        ch["wallpaper.mode"] = "image"
    elif os.path.basename(path) == "undo.bevel":
        try:
            ch["wallpaper.path"] = open(os.path.join(CACHE, "undo.path")).read().strip()
        except OSError:
            pass
    if keep and not os.path.abspath(path).startswith(tuple(os.path.abspath(d) + os.sep for d in THEME_DIRS)) \
            and os.path.basename(path) != "undo.bevel":
        os.makedirs(THEME_DIRS[0], exist_ok=True)
        shutil.copy(path, os.path.join(THEME_DIRS[0], os.path.basename(path)))
    # A theme is the whole look, bar included: whatever it doesn't set on the bar (the items you added,
    # the height, the font…) goes back to the default instead of staying from the last theme.
    # The clock format and the number of workspaces are yours, so they stay.
    cur = _flatten(load_settings().get("bar", {}), "bar.")
    drop = [k for k in cur if k not in ch and k not in THEME_KEEP]
    shell_busy()
    update_settings(ch, drop=drop)
    apply()
    ping_shell()
    return th.get("name", "")


def theme_list():
    import base64
    import hashlib
    out = []
    seen = set()
    for d in THEME_DIRS + (os.path.join(SHARE, "themes", "builtin"),):
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if not n.endswith(".bevel"):
                continue
            path = os.path.join(d, n)
            try:
                th = theme_read(path)
            except Exception:  # noqa: BLE001
                continue
            key = th.get("name", n)
            if key in seen:
                continue
            seen.add(key)
            thumb = ""
            if th.get("preview"):
                h = hashlib.sha1(th["preview"][:2000].encode()).hexdigest()[:12]
                thumb = os.path.join(CACHE, "theme-previews", h + ".png")
                if not os.path.exists(thumb):
                    os.makedirs(os.path.dirname(thumb), exist_ok=True)
                    with open(thumb, "wb") as f:
                        f.write(base64.b64decode(th["preview"]))
            out.append({"name": th.get("name", n), "author": th.get("author", ""), "path": path, "thumb": thumb,
                        "swatch": th.get("swatch", []), "builtin": "/builtin" in d or d.endswith("builtin"),
                        "hasWallpaper": bool(th.get("wallpaper")),
                        "live": th["settings"].get("wallpaper.mode") == "live"})
    out.sort(key=lambda x: (not x["builtin"], x["name"].lower()))
    return out


def control_panel(args):
    """bevelctl cp …  — small helpers for the Hyprland control panel (JSON out)."""
    a = args[0] if args else "status"
    rest = args[1:]
    if a == "status":
        print(json.dumps(cp_status()))
    elif a == "wifi-list":
        print(json.dumps(cp_wifi_scan(rescan="--rescan" in rest)))
    elif a == "wifi":
        run(["nmcli", "radio", "wifi", "on" if rest[:1] == ["on"] else "off"])
    elif a == "wifi-connect":
        ssid = rest[0] if rest else ""
        known = ssid in [_nm_split(l)[0] for l in _out(["nmcli", "-t", "-f", "NAME", "connection", "show"]).splitlines()]
        if known and len(rest) < 2:
            r = run(["nmcli", "connection", "up", "id", ssid], timeout=40)
        else:
            cmd = ["nmcli", "device", "wifi", "connect", ssid] + (["password", rest[1]] if len(rest) > 1 and rest[1] else [])
            r = run(cmd, timeout=40)
        ok = bool(r and r.returncode == 0)
        print(json.dumps({"ok": ok, "message": ((r.stdout or "") + (r.stderr or "")).strip()[-200:] if r else "nmcli missing"}))
        return 0 if ok else 1
    elif a == "wifi-disconnect":
        dev = cp_status()["wifiDevice"]
        if dev:
            run(["nmcli", "device", "disconnect", dev])
    elif a == "wifi-forget":
        run(["nmcli", "connection", "delete", "id", rest[0]] if rest else ["true"])
    elif a == "airplane":
        on = rest[:1] == ["on"]
        run(["rfkill", "block" if on else "unblock", "all"])
    elif a == "bt":
        on = rest[:1] == ["on"]
        if on:
            run(["rfkill", "unblock", "bluetooth"])
            time.sleep(0.5)
        run(["bluetoothctl", "power", "on" if on else "off"], timeout=8)
    elif a in ("bt-connect", "bt-disconnect"):
        r = run(["bluetoothctl", "connect" if a == "bt-connect" else "disconnect", rest[0]], timeout=20)
        return 0 if r and r.returncode == 0 else 1
    elif a == "nightlight":
        s = load_settings()
        on = rest[:1] == ["on"]
        temp = int(rest[1]) if len(rest) > 1 else int(s.get("display", {}).get("nightTemp", 4500))
        run(["pkill", "-x", "hyprsunset"])
        if on and shutil.which("hyprsunset"):
            time.sleep(0.2)
            subprocess.Popen(["hyprsunset", "-t", str(temp)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        update_settings({"display.nightLight": on, "display.nightTemp": temp})
        ping_shell()
    elif a == "caffeine":
        pidfile = os.path.join(CACHE, "caffeine.pid")
        if _pid_alive(pidfile):
            try:
                os.kill(int(open(pidfile).read()), 15)
            except (OSError, ValueError):
                pass
        try:
            os.remove(pidfile)
        except OSError:
            pass
        if rest[:1] == ["on"]:
            pr = subprocess.Popen(["systemd-inhibit", "--what=idle:sleep:handle-lid-switch", "--who=Bevel",
                                   "--why=Keep awake (control panel)", "--mode=block", "sleep", "infinity"],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            os.makedirs(CACHE, exist_ok=True)
            with open(pidfile, "w") as f:
                f.write(str(pr.pid))
    elif a == "profile":
        run(["powerprofilesctl", "set", rest[0]] if rest else ["true"])
    elif a == "brightness":
        brightness((rest[0] if rest else "50") + ("%" if rest and not rest[0].endswith("%") else ""), quiet=True)
    elif a == "sysinfo":
        print(json.dumps(cp_sysinfo()))
    elif a == "fetch":
        print(json.dumps(fetch_info()))
    elif a == "tz":
        print(json.dumps(cp_timezones(rest)))
    elif a == "rss":
        try:
            print(json.dumps(cp_rss(rest[0] if rest else "https://archlinux.org/feeds/news/")))
        except Exception as e:  # noqa: BLE001
            print(json.dumps({"error": str(e)[:200]}))
    elif a == "trash":
        print(json.dumps({"count": cp_trash(rest[0] if rest else "count")}))
    elif a == "cava":
        if not shutil.which("cava"):
            print("cava is not installed", file=sys.stderr)
            return 1
        os.execvp("cava", ["cava", "-p", cava_widget_conf(int(rest[0]) if rest else 24)])
    else:
        print("cp: status | wifi-list [--rescan] | wifi on|off | wifi-connect SSID [PASSWORD] | wifi-disconnect | "
              "airplane on|off | bt on|off | bt-connect MAC | bt-disconnect MAC | nightlight on|off [K] | "
              "caffeine on|off | profile NAME | brightness N | sysinfo", file=sys.stderr)
        return 1
    return 0


def focus_window(address):
    """Focus a window by its Hyprland address (Lua config first, then the classic dispatcher)."""
    a = address if address.startswith("0x") else "0x" + address
    for cmd in (['hl.dsp.focus({ window = "address:%s" })' % a], ["focuswindow", "address:%s" % a]):
        r = run(["hyprctl", "dispatch"] + cmd)
        if r and r.returncode == 0 and r.stdout.strip().lower() == "ok":
            return True
    return False


# ---------------------------------------------------------------- fullscreen
def fullscreen(kind):
    """Toggle fullscreen (or maximize). The Lua dispatcher's arguments are still
    settling between Hyprland releases, so try the known spellings in order."""
    if kind == "max":
        tries = ['hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" })',
                 'hl.dsp.window.fullscreen({ mode = 1, action = "toggle" })',
                 'hl.dsp.window.fullscreen({ mode = 1 })']
        legacy = ["fullscreen", "1"]
    else:
        tries = ['hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })',
                 'hl.dsp.window.fullscreen({ mode = 0, action = "toggle" })',
                 'hl.dsp.window.fullscreen({ mode = 0 })',
                 'hl.dsp.window.fullscreen()']
        legacy = ["fullscreen", "0"]
    for t in tries:
        r = run(["hyprctl", "dispatch", t])
        if r and r.returncode == 0 and r.stdout.strip().lower() == "ok":
            return
    run(["hyprctl", "dispatch"] + legacy)


# ---------------------------------------------------------------- session
def session():
    """Start-up: run by Hyprland once at login. Starts the wallpaper daemon and the
    shell, restarts the shell if it dies right away, and logs to ~/.cache/bevel/session.log."""
    os.makedirs(CACHE, exist_ok=True)
    log = open(os.path.join(CACHE, "session.log"), "a")
    log.write("\n==== session %s ====\n" % time.strftime("%Y-%m-%d %H:%M:%S"))
    log.flush()

    def spawn(cmd):
        try:
            return subprocess.Popen(cmd, stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            log.write("could not start %s: %s\n" % (cmd[0], e))
            log.flush()
            return None

    # apps started through D-Bus (e.g. "show in folder" opening Dolphin) must get the theme too
    systemd = os.path.isdir("/run/systemd/system")
    run(["dbus-update-activation-environment"] + (["--systemd"] if systemd else []) +
        ["QT_QPA_PLATFORMTHEME=%s" % qt_platform_theme(), "XDG_CURRENT_DESKTOP=Hyprland"])

    # without systemd (Artix…) nothing starts the sound server for you
    if not systemd:
        r = run(["pgrep", "-x", "pipewire"])
        if not (r and r.returncode == 0):
            if shutil.which("artix-pipewire-launcher"):
                spawn(["artix-pipewire-launcher"])
            else:
                for d in ("pipewire", "pipewire-pulse", "wireplumber"):
                    if shutil.which(d):
                        spawn([d])

    # other notification daemons would steal the notifications
    for d in ("mako", "dunst", "swaync", "xfce4-notifyd"):
        run(["pkill", "-x", d])

    # wallpaper daemon
    for daemon in ("awww-daemon", "swww-daemon"):
        if shutil.which(daemon):
            r = run(["pgrep", "-x", daemon])
            if not (r and r.returncode == 0):
                spawn([daemon])
            break

    # theme + wallpaper (also regenerates colors.json before the shell reads it)
    try:
        main(["restore"])
    except Exception as e:  # noqa: BLE001
        log.write("restore failed: %s\n" % e)
    # night light from the control panel
    try:
        if load_settings().get("display", {}).get("nightLight"):
            control_panel(["nightlight", "on"])
    except Exception as e:  # noqa: BLE001
        log.write("night light failed: %s\n" % e)

    if load_settings().get("fun", {}).get("chime"):
        play_chime()

    # clipboard history for Super+V
    if shutil.which("cliphist") and shutil.which("wl-paste"):
        r = run(["pgrep", "-f", "wl-paste --watch cliphist"])
        if not (r and r.returncode == 0):
            spawn(["wl-paste", "--watch", "cliphist", "-max-items", "200", "store"])

    # lock on lid close / idle
    if shutil.which("hypridle"):
        r = run(["pgrep", "-x", "hypridle"])
        if not (r and r.returncode == 0):
            spawn(["hypridle"])

    # the shell — retry a few times if it exits immediately
    if not shutil.which("qs"):
        log.write("qs (quickshell) not found in PATH\n")
        return
    for attempt in range(4):
        r = run(["pgrep", "-f", "qs -c bevel"])
        if r and r.returncode == 0 and attempt == 0:
            log.write("shell already running\n")
            break
        p = spawn(["qs", "-c", "bevel"])
        if p is None:
            break
        time.sleep(5)
        if p.poll() is None:
            log.write("shell started (pid %d)\n" % p.pid)
            break
        log.write("shell exited with code %s, retrying\n" % p.returncode)
        time.sleep(1 + attempt)
    try:
        time.sleep(2)
        welcome_at_login()
    except Exception as e:  # noqa: BLE001
        log.write("welcome failed: %s\n" % e)
    # the wallpaper daemon restores its own last picture when it starts, which can be an old one
    # from an older session: set ours once more now that everything is up
    try:
        s = load_settings()
        s["wallpaper"]["transition"] = "none"
        set_wallpaper(wall_path(s) or s["wallpaper"]["path"], s, wait=True)
    except Exception as e:  # noqa: BLE001
        log.write("wallpaper re-sync failed: %s\n" % e)
    log.flush()


# ---------------------------------------------------------------- fonts
def open_settings(action="toggle"):
    """Open (or close) Bevel Settings. It runs as its own small app on both desktops, so a
    problem in it can never take the bar down, and it can never fight the shell over settings."""
    entry = os.path.join(HOME, ".config", "quickshell", "bevel", "settings.qml")
    if not shutil.which("qs") or not os.path.exists(entry):
        print("bevelctl: Quickshell or the Bevel shell is not installed", file=sys.stderr)
        return
    r = run(["pgrep", "-u", str(os.getuid()), "-f", "qs -p .*settings[.]qml"])
    if r and r.returncode == 0:
        # it stays running (hidden) after you close it: just show / hide it
        run(["qs", "-p", entry, "ipc", "call", "settings", action if action in ("show", "hide") else "toggle"])
        return
    if action == "hide":
        return
    subprocess.Popen(["qs", "-p", entry], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def open_welcome(page=""):
    entry = os.path.join(HOME, ".config", "quickshell", "bevel", "welcome.qml")
    if not shutil.which("qs") or not os.path.exists(entry):
        return 1
    uid = str(os.getuid())
    run(["pkill", "-u", uid, "-f", "qs -p .*welcome[.]qml"])
    env = dict(os.environ, BEVEL_WELCOME_PAGE=page)
    subprocess.Popen(["qs", "-p", entry], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return 0


def welcome_at_login():
    """The tour once after installing (and every login if you ticked that box)."""
    flag = os.path.join(CFG, ".welcome-shown")
    # the tour itself marks it as seen once its window is up (so a failed start tries again next login)
    if not os.path.exists(flag) or load_settings().get("fun", {}).get("welcome"):
        open_welcome()


def fix_fonts():
    """Strip letter-joining ligatures (fi, fl, …) from the bundled pixel fonts.
    Pixelify Sans draws its 'fi' ligature wrong, which breaks text in every app."""
    try:
        from fontTools.ttLib import TTFont
    except ImportError:
        print("bevelctl: python-fonttools is missing; ligatures are only disabled inside the shell", file=sys.stderr)
        return 1
    folder = os.path.join(HOME, ".local", "share", "fonts", "bevel")
    targets = [os.path.join(folder, f) for f in ("PixelifySans.ttf", "VT323-Regular.ttf")]
    targets += [a for a in sys.argv[2:] if os.path.isfile(a)]
    fixed = 0
    for path in targets:
        if not os.path.isfile(path):
            continue
        try:
            font = TTFont(path)
            if "GSUB" not in font:
                continue
            table = font["GSUB"].table
            if not table.FeatureList:
                continue
            n = 0
            for rec in table.FeatureList.FeatureRecord:
                if rec.FeatureTag in ("liga", "clig", "dlig", "calt", "rlig") and rec.Feature.LookupListIndex:
                    rec.Feature.LookupListIndex = []
                    rec.Feature.LookupCount = 0
                    n += 1
            if n:
                font.save(path)
                fixed += 1
                print("bevel: removed ligatures from %s" % os.path.basename(path))
        except Exception as e:  # noqa: BLE001
            print("bevelctl: could not fix %s: %s" % (path, e), file=sys.stderr)
    run(["fc-cache", "-f", folder])
    return 0


# ---------------------------------------------------------------- main
def log(msg):
    try:
        os.makedirs(CACHE, exist_ok=True)
        path = os.path.join(CACHE, "bevelctl.log")
        if os.path.exists(path) and os.path.getsize(path) > 200_000:
            os.replace(path, path + ".old")
        with open(path, "a") as f:
            f.write("%s  %s\n" % (time.strftime("%H:%M:%S"), msg))
    except OSError:
        pass


def chime_file():
    """An original little start-up jingle (synthesised here, so there is no licensing worry)."""
    import math
    import struct
    import wave
    out = os.path.join(CACHE, "chime-v1.wav")
    if os.path.exists(out):
        return out
    os.makedirs(CACHE, exist_ok=True)
    rate = 44100
    notes = [(523.25, 0.00), (659.25, 0.16), (783.99, 0.32), (1046.5, 0.48), (987.77, 0.80), (1318.5, 0.96)]
    length = 3.2
    buf = [0.0] * int(rate * length)
    for freq, start in notes:
        s0 = int(start * rate)
        for i in range(int(2.0 * rate)):
            if s0 + i >= len(buf):
                break
            tt = i / rate
            env = min(1.0, tt / 0.012) * math.exp(-tt * 2.6)
            # soft square-ish tone (a few odd harmonics) + a little detuned shimmer
            v = (math.sin(2 * math.pi * freq * tt) + 0.30 * math.sin(6 * math.pi * freq * tt)
                 + 0.12 * math.sin(10 * math.pi * freq * tt) + 0.25 * math.sin(2 * math.pi * freq * 1.004 * tt))
            buf[s0 + i] += 0.16 * env * v
    # simple echo
    d = int(0.18 * rate)
    for i in range(d, len(buf)):
        buf[i] += 0.33 * buf[i - d]
    peak = max(1e-6, max(abs(x) for x in buf))
    with wave.open(out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(b"".join(struct.pack("<h", int(32000 * 0.8 * x / peak)) for x in buf))
    return out


def _pids(name):
    r = run(["pgrep", "-u", str(os.getuid()), "-x", name])
    return [int(x) for x in r.stdout.split()] if r and r.returncode == 0 else []


def _wait_gone(pids, timeout=8.0):
    end = time.time() + timeout
    while time.time() < end:
        if not any(os.path.exists("/proc/%d" % p) for p in pids):
            return True
        time.sleep(0.2)
    return False


def _cmdline(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return [a.decode(errors="ignore") for a in f.read().split(b"\0") if a]
    except OSError:
        return []


def _hypr_clients(cls=None):
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return []
    try:
        l = json.loads(_out(["hyprctl", "clients", "-j"]) or "[]")
    except ValueError:
        return []
    return [c for c in l if cls is None or (c.get("class") or c.get("initialClass") or "").lower() == cls]


def _hypr_active():
    try:
        return (json.loads(_out(["hyprctl", "activewindow", "-j"]) or "{}") or {}).get("address", "")
    except ValueError:
        return ""


def _hypr_move_silent(addr, ws):
    """Send one window to a workspace without following it. The classic dispatcher names the window;
    if this Hyprland only takes the Lua form, focus that window first so the move can't hit another."""
    r = run(["hyprctl", "dispatch", "movetoworkspacesilent", "%s,address:%s" % (ws, addr)])
    if r and r.returncode == 0 and r.stdout.strip().lower() == "ok":
        return True
    if focus_window(addr):
        r = run(["hyprctl", "dispatch", 'hl.dsp.window.move({ workspace = "%s", follow = false })' % ws])
        return bool(r and r.returncode == 0 and r.stdout.strip().lower() == "ok")
    return False


def _put_windows_back(cls, before, active, timeout=8.0):
    """After an app restarts, its windows open where you are now: move each one back to the
    workspace it was on (matched by title, else in order) and give focus back to what you were using."""
    left = list(before)
    done = set()
    end = time.time() + timeout
    while left and time.time() < end:
        for c in _hypr_clients(cls):
            a = c.get("address")
            if not a or a in done:
                continue
            done.add(a)
            match = next((o for o in left if o.get("title") == c.get("title")), left[0])
            left.remove(match)
            want = (match.get("workspace") or {}).get("name") or str((match.get("workspace") or {}).get("id", ""))
            have = (c.get("workspace") or {}).get("name") or str((c.get("workspace") or {}).get("id", ""))
            if want and want != have:
                _hypr_move_silent(a, want)
        time.sleep(0.05)
    if active and any(c.get("address") == active for c in _hypr_clients()):
        focus_window(active)


def restart_dolphin():
    """Quit Dolphin the friendly way (so it remembers its tabs) and start it again in the new colours.
    Its windows go back to their own workspaces; with no windows open it comes back without one."""
    pids = _pids("dolphin")
    if not pids:
        return False
    wins = _hypr_clients("org.kde.dolphin")
    active = _hypr_active()
    daemon_only = all("--daemon" in _cmdline(p) for p in pids) or (os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and not wins)
    for pid in pids:
        dest = "org.kde.dolphin-%d" % pid
        done = False
        if shutil.which("gdbus"):
            # every KDE window publishes its menu actions on D-Bus; find "file_quit" and press it
            r = run(["gdbus", "introspect", "--session", "--dest", dest, "--object-path", "/", "--recurse"])
            paths = []
            cur = None
            for ln in (r.stdout.splitlines() if r and r.returncode == 0 else []):
                ln = ln.strip()
                if ln.startswith("node "):
                    cur = ln.split()[1]
                    if cur.endswith("/actions/file_quit"):
                        paths.append(cur)
            for path in paths[:1]:
                r = run(["gdbus", "call", "--session", "--dest", dest, "--object-path", path,
                         "--method", "org.qtproject.Qt.QAction.trigger"])
                done = bool(r and r.returncode == 0)
        if not done:
            run(["kill", "-TERM", str(pid)])
    if not _wait_gone(pids):
        log("restart: Dolphin didn't quit, left it alone")
        return False
    cmd = ["dolphin", "--daemon"] if daemon_only else ["dolphin"]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if wins and not daemon_only:
        _put_windows_back("org.kde.dolphin", wins, active)
    log("restart: Dolphin restarted in the new colours")
    return True


def restart_firefox():
    """Close Firefox cleanly (SIGTERM = normal quit) and reopen it with the same tabs."""
    pids = [p for p in _pids("firefox") + _pids("firefox-bin")
            if "-contentproc" not in _cmdline(p)]
    if not pids:
        return False
    wins = _hypr_clients("firefox")
    active = _hypr_active()
    for pid in pids:
        run(["kill", "-TERM", str(pid)])
    if not _wait_gone(pids, 15):
        log("restart: Firefox didn't quit, left it alone")
        return False
    # bring the tabs back exactly once
    for prof in firefox_profiles():
        try:
            with open(os.path.join(prof, "prefs.js"), "a") as f:
                f.write('user_pref("browser.sessionstore.resume_session_once", true);\n')
        except OSError:
            pass
    subprocess.Popen(["firefox"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if wins:
        _put_windows_back("firefox", wins, active, timeout=15.0)
    log("restart: Firefox restarted in the new colours")
    return True


def restart_apps(which=("dolphin", "firefox")):
    if "dolphin" in which:
        restart_dolphin()
    if "firefox" in which:
        restart_firefox()


def play_chime():
    f = chime_file()
    for player in (["pw-play", f], ["paplay", f], ["aplay", "-q", f]):
        if shutil.which(player[0]):
            subprocess.Popen(player, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return


def _shells():
    """Which Bevel Quickshell instances are running: (the shell, a settings window). One pgrep."""
    if not shutil.which("qs"):
        return False, False
    r = run(["pgrep", "-u", str(os.getuid()), "-af", "qs "])
    out = r.stdout if r else ""
    return "qs -c bevel" in out, "settings.qml" in out


def _qs_call(args):
    subprocess.Popen(["qs"] + args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def shell_busy():
    """Show the shell's "repainting" screen while a wallpaper/colour change is applied."""
    if os.environ.get("WAYLAND_DISPLAY") and _shells()[0]:
        _qs_call(["-c", "bevel", "ipc", "call", "theme", "busy"])


SETTINGS_QML = os.path.join(HOME, ".config", "quickshell", "bevel", "settings.qml")


def ping_shell():
    """Tell the running shell (and a settings window) to re-read settings + colors. Doesn't wait."""
    shell, settings = _shells()
    if shell:
        _qs_call(["-c", "bevel", "ipc", "call", "theme", "reload"])
    if settings:
        _qs_call(["-p", SETTINGS_QML, "ipc", "call", "theme", "reload"])


def live_doctor():
    """Everything that matters when animated backgrounds stay black."""
    out = []
    def cmd(c, limit=40):
        if not shutil.which(c[0]):
            out.append("(%s not installed)" % c[0])
            return
        r = run(c)
        txt = (r.stdout + r.stderr) if r else "(failed to run)"
        lines = txt.strip().splitlines()
        out.extend(lines[-limit:] if lines else ["(no output)"])
    d = os.path.join(HOME, ".config", "quickshell", "bevel", "live")
    files = sorted(glob.glob(os.path.join(d, "*.frag.qsb")))
    srcs = sorted(glob.glob(os.path.join(d, "src", "*.frag")))
    out.append("shader folder: %s  (%d compiled, %d sources)" % (d, len(files), len(srcs)))
    for f in files[:1]:
        out.append("e.g. %s  %d bytes" % (os.path.basename(f), os.path.getsize(f)))
    qsb = next((q for q in ("qsb", "qsb6", "qsb-qt6", "/usr/lib/qt6/bin/qsb") if shutil.which(q) or os.access(q, os.X_OK)), None)
    out.append("qsb: %s" % (qsb or "not found (package qt6-shadertools)"))
    if qsb and files:
        r = run([qsb, "--dump", files[0]])
        if r:
            out.extend([l for l in (r.stdout + r.stderr).splitlines() if l.startswith(("QSB_VERSION", "  Shader"))][:10])
    for k in ("QT_QUICK_BACKEND", "QSG_RHI_BACKEND", "QSG_INFO", "QT_QPA_PLATFORM", "QT_OPENGL", "XDG_SESSION_TYPE", "__GLX_VENDOR_LIBRARY_NAME", "LIBVA_DRIVER_NAME"):
        out.append("%s=%s" % (k, os.environ.get(k, "")))
    cmd(["pacman", "-Q", "quickshell", "quickshell-git", "qt6-base", "qt6-declarative", "qt6-shadertools", "mesa", "nvidia", "nvidia-open", "nvidia-utils"], 12)
    r = run(["sh", "-c", "lspci -k 2>/dev/null | grep -A3 -Ei 'vga|3d|display'"])
    out.extend((r.stdout if r else "").strip().splitlines()[:12])
    settings = load_settings()
    out.append("settings: wallpaper.mode=%s live=%s" % (get_path_safe(settings, "wallpaper.mode"), json.dumps(get_path_safe(settings, "wallpaper.live"))))
    r = run(["sh", "-c", "qs log -c bevel 2>&1 | grep -iE 'shader|pipeline|live|qsb|rhi|opengl|vulkan|egl|glsl|link' | tail -n 40"])
    out.append("-- quickshell log (shader lines) --")
    out.extend((r.stdout if r else "").strip().splitlines() or ["(nothing — is the Bevel shell running?)"])
    return out


def doctor():
    out = []
    def sec(t):
        out.append("\n===== %s =====" % t)
    def cmd(c, limit=60):
        r = run(c)
        txt = (r.stdout + r.stderr) if r else "(failed to run)"
        lines = txt.strip().splitlines()
        out.extend(lines[-limit:] if lines else ["(no output)"])
    sec("versions")
    cmd(["hyprctl", "version"], 6)
    cmd(["qs", "--version"], 3)
    cmd(["uname", "-a"], 2)
    sec("distro")
    try:
        di = distro_info()
        out.append("%s (id %s, like %s) · logo %s %s · init %s" % (
            di["pretty"], di["id"], " ".join(di["like"]) or "-", di["logo"], di["logoFile"] or "",
            "systemd" if os.path.isdir("/run/systemd/system") else "not systemd"))
    except Exception as e:  # noqa: BLE001
        out.append(str(e))
    sec("hyprland config errors")
    cmd(["hyprctl", "configerrors"], 20)
    sec("files")
    for f in (SETTINGS, os.path.join(GEN, "colors.json"),
              os.path.join(HOME, ".config", "hypr", "bevel_generated.lua"),
              os.path.join(SDDM_DIR, "theme.conf.user")):
        try:
            st = os.stat(f)
            out.append("%s  %d bytes  modified %s" % (f, st.st_size, time.strftime("%H:%M:%S", time.localtime(st.st_mtime))))
        except OSError:
            out.append("%s  MISSING" % f)
    sec("settings.json")
    try:
        out.append(open(SETTINGS).read())
    except OSError as e:
        out.append(str(e))
    sec("colors.json (top)")
    try:
        out.extend(open(os.path.join(GEN, "colors.json")).read().splitlines()[:14])
    except OSError as e:
        out.append(str(e))
    sec("bevelctl.log (last 60)")
    try:
        out.extend(open(os.path.join(CACHE, "bevelctl.log")).read().splitlines()[-60:])
    except OSError:
        out.append("(none)")
    sec("session.log (last 30)")
    try:
        out.extend(open(os.path.join(CACHE, "session.log")).read().splitlines()[-30:])
    except OSError:
        out.append("(none)")
    sec("animated backgrounds")
    out.extend(live_doctor())
    sec("quickshell log (last 120)")
    cmd(["qs", "log", "-c", "bevel"], 120)
    report = os.path.join(HOME, "bevel-report.txt")
    with open(report, "w") as f:
        f.write("\n".join(out) + "\n")
    print("Report written to %s" % report)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(_usage())
        return 0
    cmd, args = argv[0], argv[1:]
    s = load_settings()
    t0 = time.time()
    if cmd == "apply":
        apply()
        ping_shell()
    elif cmd == "restore":
        wp = s["wallpaper"]["path"]
        if not wp or not os.path.isfile(expand(wp)):
            walls = list_wallpapers(s)
            if walls:
                s = update_settings({"wallpaper.path": walls[0]})
        set_wallpaper(wall_path(s) or s["wallpaper"]["path"], s, wait=True)
        apply(quiet=True, split=True)
    elif cmd == "wallpaper":
        if not args:
            print(s["wallpaper"]["path"])
            return 0
        path = os.path.abspath(expand(args[0]))
        if not os.path.isfile(path):
            print("no such file: %s" % path, file=sys.stderr)
            return 1
        shell_busy()
        s = update_settings({"wallpaper.path": path, "wallpaper.mode": "image",
                             "wallpaper.recent": ([path] + [r for r in s["wallpaper"].get("recent", []) if r != path])[:30]})
        set_wallpaper(path, s)
        apply(split=True)
        ping_shell()
    elif cmd == "random":
        # live background on: a random animation; otherwise a random picture (or favourite)
        if is_live(s) and not args:
            kinds = [k for k in LIVE_KINDS if k != live_cfg(s)["kind"]]
            return main(["live", random.choice(kinds)])
        cur = expand(s["wallpaper"]["path"])
        pool = list_wallpapers(s)
        if (args[:1] == ["favorites"] or (not args and s["wallpaper"].get("randomFrom") == "favorites")):
            favs = [f for f in s["wallpaper"].get("favorites", []) if os.path.isfile(f)]
            pool = favs or pool
        walls = [w for w in pool if w != cur] or pool
        if not walls:
            print("no wallpapers in %s" % s["wallpaper"]["folder"], file=sys.stderr)
            return 1
        return main(["wallpaper", random.choice(walls)])
    elif cmd == "live":
        # bevelctl live [KIND] [COLOR] [PALETTE] | live off | live list
        if args[:1] == ["list"]:
            print("\n".join(LIVE_KINDS))
            return 0
        before = (is_live(s), live_cfg(s)["color"], live_cfg(s)["palette"])
        ch = {}
        if args[:1] == ["off"]:
            ch["wallpaper.mode"] = "image"
        else:
            ch["wallpaper.mode"] = "live"
            for a in args:
                if a in LIVE_KINDS:
                    ch["wallpaper.live.kind"] = a
                elif re.match(r"^#?[0-9a-fA-F]{6}$", a):
                    ch["wallpaper.live.color"] = "#" + a.lstrip("#")
                elif a in ("night", "dusk", "neon", "pastel", "day", "mono"):
                    ch["wallpaper.live.palette"] = a
                else:
                    print("unknown: %s (kinds: bevelctl live list)" % a, file=sys.stderr)
                    return 1
        for k, v in ch.items():
            set_path(s, k, v)
        if (is_live(s), live_cfg(s)["color"], live_cfg(s)["palette"]) != before:
            shell_busy()                       # the colours change: show "repainting"
        update_settings(ch)
        apply(split=True)
        ping_shell()
    elif cmd == "set":
        if len(args) < 2 or len(args) % 2:
            print("usage: bevelctl set KEY VALUE [KEY VALUE ...]", file=sys.stderr)
            return 1
        ch = {}
        for k, v in zip(args[0::2], args[1::2]):
            ch[k] = parse_value(v)
            if k.startswith(("style.", "windows.", "bar.floating")) and k != "style.preset" and not k.startswith("style.font") and k != "style.monoFont":
                ch["style.preset"] = "custom"
        update_settings(ch)
        apply(quiet=True, split=True)
        ping_shell()
    elif cmd == "patch":
        # bevelctl patch '{"dotted.key": value, …}' [--apply]   (the shell and settings window use this)
        try:
            ch = json.loads(args[0]) if args and args[0] not in ("", "--apply") else {}
            assert isinstance(ch, dict)
        except (ValueError, AssertionError):
            print("usage: bevelctl patch JSON-OBJECT [--apply]", file=sys.stderr)
            return 1
        recolour = any(k.startswith(COLOUR_KEYS) and json.dumps(get_path_safe(s, k)) != json.dumps(v)
                       for k, v in ch.items())
        if recolour and "--apply" in args:
            shell_busy()
        if ch:
            update_settings(ch)
        if "--apply" in args:
            apply(quiet=True, split=True)
        ping_shell()
    elif cmd == "preset":
        name = args[0] if args else ""
        if name not in PRESETS:
            print("presets: %s" % ", ".join(PRESETS), file=sys.stderr)
            return 1
        ch = dict(PRESETS[name])
        ch["style.preset"] = name
        update_settings(ch)
        apply(quiet=True, split=True)
        ping_shell()
    elif cmd == "get":
        print(json.dumps(get_path(s, args[0]) if args else s, indent=2))
    elif cmd == "list-wallpapers":
        print(json.dumps(list_wallpapers(s)))
    elif cmd == "thumbs":
        print(json.dumps(thumbnails(s, make="--quick" not in args)))
    elif cmd == "info":
        print(json.dumps(system_info()))
    elif cmd == "scales":
        print(json.dumps(scale_options()))
    elif cmd == "displays":
        if args[:1] == ["reset"]:
            # back to one simple rule for every screen (if a setting left you with a black screen)
            update_settings({"display.monitors": {}, "display.primary": ""})
            apply(quiet=True)
            print("bevel: displays reset")
        else:
            print(json.dumps(displays()))
    elif cmd == "update":
        return update(args)
    elif cmd == "version":
        print(bevel_version())
    elif cmd == "edit":
        return edit(args)
    elif cmd == "keyboard":
        # bevelctl keyboard          what Hyprland gets (JSON)
        # bevelctl keyboard detect   take the layout your system uses (the installer runs this once)
        if args[:1] == ["detect"]:
            kb = system_keyboard()
            if kb["layout"]:
                update_settings({"keyboard.layout": kb["layout"], "keyboard.variant": kb["variant"],
                                 "keyboard.options": kb["options"]})
                if "--apply" in args:
                    apply(quiet=True, split=True)
            print(json.dumps(kb))
        else:
            print(json.dumps(keyboard_cfg(load_settings())))
    elif cmd == "shot":
        screenshot(args[0] if args else "region")
    elif cmd == "session":
        session()
    elif cmd == "brightness":
        brightness(args[0] if args else "get")
    elif cmd == "welcome":
        return open_welcome(args[0] if args else "")
    elif cmd == "theme":
        a = args[0] if args else "list"
        if a == "list":
            print(json.dumps(theme_list()))
        elif a == "export":
            if len(args) < 2:
                print("usage: bevelctl theme export NAME [--no-wallpaper] [--author NAME] [--file PATH]", file=sys.stderr)
                return 1
            author = args[args.index("--author") + 1] if "--author" in args else ""
            out = args[args.index("--file") + 1] if "--file" in args else None
            print(theme_export(args[1], author, out, "--no-wallpaper" not in args))
        elif a in ("import", "apply"):
            if len(args) < 2:
                print("usage: bevelctl theme import FILE.bevel", file=sys.stderr)
                return 1
            target = args[1]
            if not os.path.isfile(target):            # a name from the list
                match = [x for x in theme_list() if x["name"].lower() == target.lower()]
                if not match:
                    print("no such theme: %s" % target, file=sys.stderr)
                    return 1
                target = match[0]["path"]
            try:
                name = theme_import(target)
            except Exception as e:  # noqa: BLE001
                print("could not import: %s" % e, file=sys.stderr)
                run(["notify-send", "-a", "Bevel", "Could not import the theme", str(e)[:200]])
                return 1
            run(["notify-send", "-a", "Bevel", "Theme applied", "%s is on. Undo it in Settings → Themes." % name])
        elif a == "undo":
            u = os.path.join(CACHE, "undo.bevel")
            if not os.path.exists(u):
                print("nothing to undo", file=sys.stderr)
                return 1
            theme_import(u, keep=False, undo=False)
        elif a == "delete":
            for x in theme_list():
                if (x["name"] == (args[1] if len(args) > 1 else "")) and not x["builtin"]:
                    os.remove(x["path"])
        else:
            print("bevelctl theme list | export NAME | import FILE | apply NAME | undo | delete NAME", file=sys.stderr)
            return 1
    elif cmd == "focus":
        return 0 if args and focus_window(args[0]) else 1
    elif cmd == "fullscreen":
        fullscreen(args[0] if args else "full")
    elif cmd == "reset":
        save_settings(DEFAULTS)
        apply()
        ping_shell()
    elif cmd == "doctor":
        if args[:1] == ["live"]:
            print("\n".join(live_doctor()))
        else:
            doctor()
    elif cmd == "settings":
        open_settings(args[0] if args else "toggle")
    elif cmd == "apps-setup":
        apps_setup()
    elif cmd == "chime":
        play_chime()
    elif cmd == "lock":
        # lock the screen on either desktop
        subprocess.Popen(["sh", "-c", "pidof hyprlock || hyprlock"], start_new_session=True)
    elif cmd == "opsec":
        if args and args[0] == "stop":
            opsec_stop()
        else:
            opsec_start()
    elif cmd == "opsec-fx":
        return opsec_fx(args[0] if args else "hack")
    elif cmd == "restart-apps":
        restart_apps(tuple(args) or ("dolphin", "firefox"))
    elif cmd == "distro":
        if args[:1] == ["--json"]:
            print(json.dumps(distro_info(), indent=2))
        else:
            print(distro_name())
    elif cmd in ("flyout", "menu"):
        kind = args[0] if args else "clock"
        if kind not in FLYOUT_KINDS:
            print("usage: bevelctl flyout clock|battery|sound|network|system|notifs", file=sys.stderr)
            return 2
        run(["qs", "-c", "bevel", "ipc", "call", "flyout", "toggle", kind])
        return 0
    elif cmd in ("controlpanel", "control-panel"):
        run(["qs", "-c", "bevel", "ipc", "call", "controlpanel", args[0] if args else "toggle"])
        return 0
    elif cmd == "apply-rest":
        return apply_rest(int(args[0]) if args else _apply_gen())
    elif cmd == "cp":
        return control_panel(args)
    elif cmd == "fix-fonts":
        return fix_fonts()
    else:
        print("unknown command: %s\n%s" % (cmd, _usage()), file=sys.stderr)
        return 1
    if cmd in ("apply", "wallpaper", "set", "preset", "reset", "random", "restore", "live", "patch"):
        log("%s %s  (%d ms)" % (cmd, " ".join(args)[:120], (time.time() - t0) * 1000))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
