import os
import random
import re
import shutil


class _Later:
    """A module imported the first time it's used (configparser alone costs ~10 ms at every start)."""
    def __init__(self, name):
        self._name, self._mod = name, None

    def __getattr__(self, attr):
        if self._mod is None:
            import importlib
            self._mod = importlib.import_module(self._name)
        return getattr(self._mod, attr)


configparser = _Later("configparser")


def _usage():
    # the help text, without the edition markers in it
    return "\n".join(l for l in (__doc__ or "").splitlines() if not l.startswith("#"))
