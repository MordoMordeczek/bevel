        "tab.inactiveBackground": e["face2"], "tab.inactiveForeground": e["text"], "tab.border": e["lo"],
        "tab.hoverBackground": e["face"],
        "statusBar.background": e["face"], "statusBar.foreground": e["text"], "statusBar.border": e["lo"],
        "statusBar.debuggingBackground": e["accent"], "statusBar.debuggingForeground": e["on_accent"],
        "statusBar.noFolderBackground": e["face"], "statusBarItem.remoteBackground": e["accent"],
        "statusBarItem.remoteForeground": e["on_accent"], "statusBarItem.hoverBackground": e["face2"],
        "panel.background": e["bg"], "panel.border": e["lo"], "panelTitle.activeBorder": e["accent"],
        "panelTitle.activeForeground": e["fg"], "panelTitle.inactiveForeground": e["dim"],
        "input.background": e["base"], "input.foreground": e["text"], "input.border": e["lo"],
        "input.placeholderForeground": e["text_dim"], "inputOption.activeBorder": e["accent"],
        "dropdown.background": e["base"], "dropdown.foreground": e["text"], "dropdown.border": e["lo"],
        "button.background": e["accent"], "button.foreground": e["on_accent"], "button.hoverBackground": e["accent2"],
        "button.secondaryBackground": e["face2"], "button.secondaryForeground": e["text"],
        "focusBorder": e["accent"], "contrastBorder": e["lo"], "widget.shadow": "#00000066",
        "badge.background": e["accent"], "badge.foreground": e["on_accent"],
        "progressBar.background": e["accent"],
        "scrollbarSlider.background": e["lo"] + "99", "scrollbarSlider.hoverBackground": e["lo"] + "cc",
        "scrollbarSlider.activeBackground": e["accent"],
        "editor.background": e["bg"], "editor.foreground": e["fg"],
        "editorLineNumber.foreground": e["dim"], "editorLineNumber.activeForeground": e["accent2"],
        "editorCursor.foreground": e["accent2"], "editor.selectionBackground": e["accent"] + "88",
        "editor.lineHighlightBackground": e["bg2"], "editor.findMatchBackground": e["yellow"] + "66",
        "editor.findMatchHighlightBackground": e["yellow"] + "33", "editorIndentGuide.background1": e["bg3"],
        "editorWhitespace.foreground": e["bg3"], "editorBracketMatch.border": e["accent2"],
        "editorWidget.background": e["face"], "editorWidget.foreground": e["text"], "editorWidget.border": e["dark_c"],
        "editorSuggestWidget.background": e["face"], "editorSuggestWidget.foreground": e["text"],
        "editorSuggestWidget.selectedBackground": e["accent"], "editorSuggestWidget.selectedForeground": e["on_accent"],
        "editorHoverWidget.background": e["face"], "editorHoverWidget.foreground": e["text"],
        "editorHoverWidget.border": e["dark_c"], "editorGutter.background": e["bg"],
        "editorError.foreground": e["red"], "editorWarning.foreground": e["yellow"], "editorInfo.foreground": e["blue"],
        "minimap.background": e["bg"],
        "terminal.background": e["bg"], "terminal.foreground": e["fg"], "terminalCursor.foreground": e["accent2"],
        "breadcrumb.background": e["bg"], "breadcrumb.foreground": e["dim"],
        "notifications.background": e["face"], "notifications.foreground": e["text"], "notifications.border": e["dark_c"],
        "notificationCenterHeader.background": e["accent"], "notificationCenterHeader.foreground": e["on_accent"],
        "quickInput.background": e["face"], "quickInput.foreground": e["text"],
        "quickInputList.focusBackground": e["accent"], "quickInputList.focusForeground": e["on_accent"],
        "pickerGroup.foreground": e["accent"], "pickerGroup.border": e["lo"],
        "gitDecoration.modifiedResourceForeground": e["yellow"], "gitDecoration.untrackedResourceForeground": e["green"],
        "gitDecoration.deletedResourceForeground": e["red"],
    }
    for i in range(16):
        names = ["Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White"]
        c["terminal.ansi%s%s" % ("Bright" if i >= 8 else "", names[i % 8])] = p["ansi"]["color%d" % i]
    def tok(scope, fg, style=None):
        d = {"scope": scope, "settings": {"foreground": fg}}
        if style:
            d["settings"]["fontStyle"] = style
        return d
    tokens = [
        tok(["comment", "punctuation.definition.comment"], e["comment"], "italic"),
        tok(["string", "string.quoted", "markup.inline.raw"], e["green"]),
        tok(["constant.numeric", "constant.language", "constant.character"], e["yellow"]),
        tok(["keyword", "storage", "storage.type", "keyword.control"], e["accent2"], "bold"),
        tok(["keyword.operator", "punctuation"], e["fg"]),
        tok(["entity.name.function", "support.function", "meta.function-call"], e["blue"]),
        tok(["entity.name.type", "entity.name.class", "support.type", "support.class"], e["cyan"]),
        tok(["variable.parameter", "variable.other.property"], e["magenta"]),
        tok(["entity.name.tag", "markup.heading"], e["red"]),
        tok(["entity.other.attribute-name"], e["yellow"]),
        tok(["invalid"], e["red"], "underline"),
    ]
    return {"name": "Bevel", "type": "dark" if e["dark"] else "light", "colors": c, "tokenColors": tokens,
            "semanticHighlighting": True}


def vscode_package(s):
    dark = bool(s["colors"].get("darkTerminal", True))
    return {"name": "bevel-theme", "displayName": "Bevel", "description": "Colours from your Bevel rice (updated by bevelctl)",
            "version": "1.0.0", "publisher": "bevel", "engines": {"vscode": "^1.60.0"}, "categories": ["Themes"],
            "contributes": {"themes": [{"label": "Bevel", "uiTheme": "vs-dark" if dark else "vs",
                                        "path": "./themes/bevel-color-theme.json"}]}}


def write_vscode(s, p):
    """Keep the installed Bevel theme extension in your current colours."""
    theme = json.dumps(vscode_theme(s, p), indent=2)
    pkg = json.dumps(vscode_package(s), indent=2)
    for d in VSCODE_EXT_DIRS:
        for ext in glob.glob(os.path.join(HOME, d, "bevel.bevel-theme-*")):
            write_atomic(os.path.join(ext, "themes", "bevel-color-theme.json"), theme)
            write_atomic(os.path.join(ext, "package.json"), pkg)


def vscode_setup(s, p):
    """Install the theme extension into every VS Code flavour present and switch to it."""
    import zipfile
    clis = [c for c in ("code", "codium", "code-oss") if shutil.which(c)]
    if not clis:
        return
    vsix = os.path.join(CACHE, "bevel-theme.vsix")
    os.makedirs(CACHE, exist_ok=True)
    manifest = """<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="bevel-theme" Version="1.0.0" Publisher="bevel" />
    <DisplayName>Bevel</DisplayName>
    <Description xml:space="preserve">Colours from your Bevel rice</Description>
    <Categories>Themes</Categories>
    <Properties><Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.60.0" /></Properties>
  </Metadata>
  <Installation><InstallationTarget Id="Microsoft.VisualStudio.Code" /></Installation>
  <Dependencies />
  <Assets><Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true" /></Assets>
</PackageManifest>
"""
    types = ('<?xml version="1.0" encoding="utf-8"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
             '<Default Extension=".json" ContentType="application/json"/><Default Extension=".vsixmanifest" ContentType="text/xml"/></Types>')
    with zipfile.ZipFile(vsix, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", types)
        z.writestr("extension.vsixmanifest", manifest)
        z.writestr("extension/package.json", json.dumps(vscode_package(s), indent=2))
        z.writestr("extension/themes/bevel-color-theme.json", json.dumps(vscode_theme(s, p), indent=2))
    for cli in clis:
        r = run([cli, "--install-extension", vsix, "--force"])
        log("vscode: %s --install-extension -> %s" % (cli, "ok" if r and r.returncode == 0 else (r.stderr.strip()[:200] if r else "timeout")))
    wanted = {"workbench.colorTheme": "Bevel"}
    defaults = {"editor.fontFamily": "'JetBrains Mono', monospace", "editor.fontLigatures": False,
                "terminal.integrated.fontFamily": "'JetBrains Mono'", "editor.cursorStyle": "block",
                "editor.cursorBlinking": "solid", "window.titleBarStyle": "custom",
                "window.menuBarVisibility": "classic", "editor.minimap.renderCharacters": False}
    for flavour in VSCODE_SETTINGS:
        cfgdir = os.path.join(HOME, ".config", flavour)
        if flavour == "Code - OSS" and not shutil.which("code-oss") and not (shutil.which("code") and os.path.isdir("/usr/lib/code")):
            if not os.path.isdir(cfgdir):
                continue
        if flavour == "Code" and not os.path.isdir(cfgdir) and not os.path.isdir("/opt/visual-studio-code"):
            continue
        if flavour == "VSCodium" and not shutil.which("codium"):
            continue
        path = os.path.join(cfgdir, "User", "settings.json")
        cur = {}
        if os.path.exists(path):
            cur = load_jsonc(path)
            if cur is None:
                log("vscode: could not read %s (left alone; pick the Bevel theme yourself: Ctrl+K Ctrl+T)" % path)
                continue
        new = dict(cur)
        new.update(wanted)
        for k, v in defaults.items():
            new.setdefault(k, v)
        if new != cur:
            if os.path.exists(path):
                shutil.copy(path, path + ".before-bevel")
            write_atomic(path, json.dumps(new, indent=4) + "\n")


def load_jsonc(path):
    """Read a JSON-with-comments file (VS Code settings). None if it can't be parsed."""
    import re
    try:
        with open(path) as f:
            text = f.read()
    except OSError:
        return None
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        ch = text[i]
        if in_str:
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if ch == '"':
                in_str = False
        elif ch == '"':
            in_str = True
            out.append(ch)
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
            continue
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        else:
            out.append(ch)
        i += 1
    clean = re.sub(r",(\s*[}\]])", r"\1", "".join(out))
    try:
        return json.loads(clean) if clean.strip() else {}
    except ValueError:
        return None


