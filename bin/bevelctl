  --sidebar-text-color: var(--bv-text) !important;

  /* compact: tabs and toolbar about as tall as the 9x title bar and taskbar */
  --tab-min-height: 22px !important;
  --tab-block-margin: 0px !important;
  --tab-inline-padding: 6px !important;
  --toolbarbutton-outer-padding: 1px !important;
  --toolbarbutton-inner-padding: 4px !important;
  --toolbar-start-end-padding: 3px !important;
  --urlbar-min-height: 22px !important;
  --urlbar-container-height: 28px !important;
  --urlbar-padding-block: 2px !important;
}}
#TabsToolbar, #TabsToolbar-customization-target, #tabbrowser-tabs, #tabbrowser-arrowscrollbox {{ min-height: 26px !important; }}
.tabbrowser-tab {{ min-height: 26px !important; max-height: 26px !important; padding-block: 0 !important; }}
.tab-content {{ min-height: 0 !important; }}
.tab-label {{ font-size: 12px !important; }}
.tab-icon-image, .tab-throbber, .tab-icon-pending {{ width: 14px !important; height: 14px !important; }}
.tab-close-button {{ width: 18px !important; height: 18px !important; padding: 3px !important; }}
#nav-bar {{ min-height: 0 !important; padding-block: 1px !important; }}
#nav-bar toolbarbutton, #TabsToolbar toolbarbutton {{ --toolbarbutton-inner-padding: 4px !important; }}
#urlbar-container, #search-container {{ padding-block: 2px !important; min-height: 0 !important; }}
#urlbar-input, #urlbar {{ font-size: 12px !important; }}
#PersonalToolbar {{ min-height: 0 !important; padding-block: 1px !important; }}

/* toolbars: one flat 9x surface with a dark rule under it */
#navigator-toolbox, #TabsToolbar, #nav-bar, #PersonalToolbar, #titlebar {{
  background: var(--bv-face) !important;
  color: var(--bv-text) !important;
  border-color: var(--bv-lo) !important;
}}
#navigator-toolbox {{ border-bottom: 1px solid var(--bv-dark) !important; }}
#navigator-toolbox, menupopup, panel, #urlbar-input, .tab-label {{ font-family: "{font}", sans-serif !important; }}

/* tabs: raised 9x tabs, the selected one pops forward */
.tabbrowser-tab .tab-background {{
  border-radius: 0 !important;
  background: var(--bv-face) !important;
  box-shadow: var(--bv-raised) !important;
  margin-block: 3px 0 !important;
  min-height: 0 !important;
  outline: none !important;
}}
.tabbrowser-tab[selected] .tab-background, .tabbrowser-tab[multiselected] .tab-background {{
  background: var(--bv-face2) !important;
  margin-block: 1px 0 !important;
}}
.tabbrowser-tab:hover:not([selected]) .tab-background {{ background: var(--bv-face2) !important; }}
.tab-close-button {{ border-radius: 0 !important; }}

/* address bar: sunken white field */
#urlbar-background, #searchbar {{
  border-radius: 0 !important;
  background: var(--bv-base) !important;
  border: none !important;
  box-shadow: var(--bv-sunken) !important;
}}
#urlbar[focused] #urlbar-background {{ outline: 1px dotted var(--bv-accent) !important; outline-offset: -4px !important; }}
#urlbar[open] #urlbar-background {{ box-shadow: var(--bv-sunken), 0 0 0 1px var(--bv-dark) !important; }}

/* toolbar buttons: flat until hovered, raised on hover, sunken when pressed */
toolbarbutton {{ --toolbarbutton-hover-background: transparent !important; --toolbarbutton-active-background: transparent !important; }}
toolbarbutton .toolbarbutton-icon, toolbarbutton .toolbarbutton-badge-stack, toolbarbutton .toolbarbutton-text {{ border-radius: 0 !important; }}
#nav-bar toolbarbutton:not([disabled]):hover > .toolbarbutton-icon,
#nav-bar toolbarbutton:not([disabled]):hover > .toolbarbutton-badge-stack {{
  background: var(--bv-face) !important; box-shadow: var(--bv-raised) !important;
}}
#nav-bar toolbarbutton:not([disabled]):is(:active, [open], [checked]) > .toolbarbutton-icon,
#nav-bar toolbarbutton:not([disabled]):is(:active, [open], [checked]) > .toolbarbutton-badge-stack {{
  background: var(--bv-face2) !important; box-shadow: var(--bv-sunken) !important;
}}

/* menus and popups: square, raised, accent highlight */
menupopup, panel {{ --panel-background: var(--bv-face) !important; --panel-color: var(--bv-text) !important; --panel-border-color: var(--bv-dark) !important; }}
menupopup > menuitem[_moz-menuactive], menupopup > menu[_moz-menuactive] {{
  background: var(--bv-accent) !important; color: var(--bv-on-accent) !important;
}}
"""
    content = firefox_newtab_css(s, p, font)
    prefs = {
        "toolkit.legacyUserProfileCustomizations.stylesheets": "true",
        "browser.tabs.inTitlebar": "0",
        "svg.context-properties.content.enabled": "true",
        "browser.compactmode.show": "true",
        "browser.uidensity": "1",                           # Firefox's own compact mode
        "browser.newtabpage.activity-stream.newtabWallpapers.enabled": "false",  # ours instead
    }
    pref_block = "// bevel-generated (bevelctl rewrites these lines)\n" + "".join(
        'user_pref("%s", %s);\n' % kv for kv in prefs.items())
    wall_png = firefox_newtab_image(s)
    for prof in firefox_profiles():
        for name, text in (("userChrome.css", css), ("userContent.css", content)):
            path = os.path.join(prof, "chrome", name)
            mine = True
            if os.path.exists(path):
                with open(path) as f:
                    mine = "bevel-generated" in f.read(200)
            if mine:
                write_atomic(path, text)
        if wall_png:
            dst = os.path.join(prof, "chrome", "bevel-newtab.png")
            if file_sig(dst) != file_sig(wall_png):
                shutil.copyfile(wall_png, dst)
        # user.js: drop our old lines, keep everything of yours, add ours at the end
        uj = os.path.join(prof, "user.js")
        existing = ""
        if os.path.exists(uj):
            with open(uj) as f:
                existing = f.read()
        keep = [ln for ln in existing.splitlines()
                if not ln.startswith("// bevel-generated")
                and not any(ln.startswith('user_pref("%s"' % k) for k in prefs)]
        while keep and not keep[-1].strip():
            keep.pop()
        write_atomic(uj, ("\n".join(keep) + "\n" if keep else "") + pref_block)


def firefox_newtab_image(s):
    """The wallpaper, scaled for Firefox's new tab page (cached until the wallpaper changes)."""
    src = wall_path(s)
    if not src or not os.path.isfile(src):
        return None
    out = os.path.join(CACHE, "firefox-newtab.png")
    stamp = out + ".src"
    st = os.stat(src)
    key = "%s|%d|%d" % (src, st.st_mtime, st.st_size)
    try:
        with open(stamp) as f:
            if f.read() == key and os.path.exists(out):
                return out
    except OSError:
        pass
    try:
        from PIL import Image
        im = Image.open(src).convert("RGB")
        if im.width > 1920:
            im = im.resize((1920, round(im.height * 1920 / im.width)), Image.LANCZOS)
        os.makedirs(CACHE, exist_ok=True)
        im.save(out, optimize=True)
        with open(stamp, "w") as f:
            f.write(key)
        return out
    except Exception as e:  # noqa: BLE001
        log("firefox new tab image: %s" % e)
        return None


