def halfblock_art(rows, colors):
    """Pixel art for the terminal: two pixels per character cell (▀ ▄), in true colour."""
    out = []
    for y in range(0, len(rows), 2):
        top = rows[y]
        bot = rows[y + 1] if y + 1 < len(rows) else "." * len(top)
        line = ""
        for x in range(len(top)):
            t, b = colors.get(top[x]), colors.get(bot[x])
            if t and b and t == b:
                line += "\x1b[38;2;%d;%d;%dm█" % t
            elif t and b:
                line += "\x1b[38;2;%d;%d;%dm\x1b[48;2;%d;%d;%dm▀\x1b[49m" % (t + b)
            elif t:
                line += "\x1b[38;2;%d;%d;%dm▀" % t
            elif b:
                line += "\x1b[38;2;%d;%d;%dm▄" % b
            else:
                line += " "
        out.append(line + "\x1b[0m")
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------- your distro
# Everything that says "Arch" (fastfetch, the btw badge and widget, the login screen) asks here instead,
# so CachyOS says CachyOS. Settings → Fun can override the name and the logo.
ARCH_FAMILY = {"arch", "artix", "manjaro", "endeavouros", "cachyos", "garuda", "arcolinux", "archcraft", "rebornos",
               "archlabs", "mabox", "xerolinux", "archbang", "parabola", "hyperbola", "blendos", "bluestar", "crystal",
               "biglinux", "obarun", "steamos", "chimeraos"}
DISTRO_LOGO_GRID = 32


def os_release():
    """/etc/os-release as a dict (BEVEL_OS_RELEASE points somewhere else, for testing)."""
    kv = {}
    for path in (os.environ.get("BEVEL_OS_RELEASE"), "/etc/os-release", "/usr/lib/os-release"):
        if not path:
            continue
        try:
            with open(path) as f:
                for ln in f:
                    if "=" in ln and not ln.lstrip().startswith("#"):
                        k, v = ln.rstrip("\n").split("=", 1)
                        kv[k.strip()] = v.strip().strip('"').strip("'")
            return kv
        except OSError:
            continue
    return kv


def find_distro_logo(names):
    """The distro's own logo file (a picture its branding package installed), or ''."""
    roots = [os.path.join(HOME, ".local", "share", "icons", "hicolor"), "/usr/share/icons/hicolor"]
    sizes = ("scalable", "512x512", "256x256", "192x192", "128x128", "96x96", "64x64", "48x48")
    for n in names:
        if not n or "/" in n:
            continue
        cands = ["%s/%s.%s" % (d, n, e) for d in ("/usr/share/pixmaps", "/usr/share/icons") for e in ("svg", "png")]
        cands += ["%s/%s/apps/%s.%s" % (r, z, n, e) for r in roots for z in sizes for e in ("svg", "png")]
        for c in cands:
            if os.path.isfile(c):
                return c
    return ""


def distro_info(s=None):
    """id, names and logo of the distro you run, with the Settings → Fun overrides applied."""
    kv = os_release()
    did = (kv.get("ID") or "linux").lower()
    like = (kv.get("ID_LIKE") or "").lower().split()
    full = kv.get("NAME") or kv.get("ID") or "Linux"
    fun = (s if s is not None else load_settings()).get("fun", {})
    custom = (fun.get("distroName") or "").strip()
    mode = fun.get("distroLogo", "auto")
    if mode not in ("auto", "arch", "classic", "none"):
        mode = "auto"
    path = "" if mode in ("arch", "none") else find_distro_logo([kv.get("LOGO"), did, did + "-logo", "distributor-logo-" + did])
    if mode == "none":
        kind = "none"
    elif mode == "arch" or (did == "arch" and (mode == "auto" or not path)):
        kind = "arch"
    else:
        kind = "system" if path else "generic"
    color = ""
    m = re.search(r"38;2;(\d+);(\d+);(\d+)", kv.get("ANSI_COLOR", ""))
    if m:
        color = "#%02x%02x%02x" % tuple(int(x) for x in m.groups())
    return {
        "id": did, "like": like, "archBased": did in ARCH_FAMILY or "arch" in like,
        "name": custom or re.sub(r"\s+(GNU/)?Linux$", "", full).strip() or "Linux",
        "detected": re.sub(r"\s+(GNU/)?Linux$", "", full).strip() or "Linux",
        "fullName": custom or full, "pretty": kv.get("PRETTY_NAME") or full,
        "logoMode": mode, "logo": kind, "logoFile": path, "color": color,
    }


def distro_name(s=None):
    """'Arch', 'CachyOS', … or the name you set in Settings → Fun."""
    try:
        return distro_info(s)["name"]
    except Exception:  # noqa: BLE001 — a name is never worth a crash
        return "Linux"


def btw_text(s):
    t = (s.get("fun", {}).get("btwText") or "").strip()
    return t or "I use %s btw" % distro_name(s)


def distro_pixels(path):
    """The distro's logo as DISTRO_LOGO_GRID² pixel art in a few colours, with a 9x light left edge and
    dark right edge: (rows, {char: (r, g, b)}). Cached per file; None if it can't be read."""
    try:
        st = os.stat(path)
    except OSError:
        return None
    key = "%s|%d|%d" % (path, st.st_mtime, DISTRO_LOGO_GRID)
    cache = os.path.join(CACHE, "distro-logo.json")
    try:
        with open(cache) as f:
            c = json.load(f)
        if c.get("key") == key:
            return c["rows"], {k: tuple(v) for k, v in c["colors"].items()}
    except (OSError, ValueError, KeyError):
        pass
    try:
        from PIL import Image
    except ImportError:
        return None
    try:
        if path.endswith(".svg"):
            png = None
            for cmd in (["rsvg-convert", "-w", "256", "-h", "256", "--keep-aspect-ratio", path],
                        ["magick", "-background", "none", "-density", "300", path, "-resize", "256x256", "png:-"],
                        ["convert", "-background", "none", "-density", "300", path, "-resize", "256x256", "png:-"]):
                if shutil.which(cmd[0]):
                    r = subprocess.run(cmd, capture_output=True, timeout=15)
                    if r.returncode == 0 and r.stdout:
                        png = r.stdout
                        break
            if png is None:
                return None
            img = Image.open(io.BytesIO(png))
        else:
            img = Image.open(path)
        img = img.convert("RGBA")
    except Exception:  # noqa: BLE001
        return None
    box = img.getchannel("A").point(lambda a: 255 if a > 40 else 0).getbbox()
    if not box:
        return None
    img = img.crop(box)
    n = DISTRO_LOGO_GRID
    w, h = img.size
    k = n / max(w, h)
    img = img.resize((max(1, round(w * k)), max(1, round(h * k))), Image.BOX)
    canvas = Image.new("RGBA", (n, n), (0, 0, 0, 0))
    canvas.paste(img, ((n - img.size[0]) // 2, (n - img.size[1]) // 2))
    alpha = canvas.getchannel("A")
    a = alpha.load()
    on = [[a[x, y] >= 110 for x in range(n)] for y in range(n)]
    # a few flat colours, like a 16-colour icon; see-through pixels get the average so they don't use a slot
    opaque = [canvas.getpixel((x, y))[:3] for y in range(n) for x in range(n) if on[y][x]]
    if not opaque:
        return None
    avg = tuple(sum(c[i] for c in opaque) // len(opaque) for i in range(3))
    flat = Image.new("RGB", (n, n), avg)
    flat.paste(canvas.convert("RGB"), (0, 0), alpha.point(lambda v: 255 if v >= 110 else 0))
    rgb = flat.quantize(colors=6, method=Image.Quantize.MEDIANCUT).convert("RGB").load()
    pal, rows = {}, []
    pool = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

    def shade(c, f):
        return tuple(max(0, min(255, round(v * f + (255 * (f - 1) if f > 1 else 0) * 0.35))) for v in c)
    for y in range(n):
        row = ""
        for x in range(n):
            if not on[y][x]:
                row += "."
                continue
            c = rgb[x, y]
            def solid(xx, yy):
                return 0 <= xx < n and 0 <= yy < n and on[yy][xx]
            # 9x bevel on shapes at least 2 px thick: lit from the top left, shadow on the bottom right
            if (not solid(x - 1, y) or not solid(x, y - 1)) and solid(x + 1, y) and solid(x, y + 1):
                c = shade(c, 1.28)
            elif (not solid(x + 1, y) or not solid(x, y + 1)) and solid(x - 1, y) and solid(x, y - 1):
                c = shade(c, 0.68)
            if c not in pal:
                if len(pal) >= len(pool):
                    c = min(pal, key=lambda q: sum((q[i] - c[i]) ** 2 for i in range(3)))
                else:
                    pal[c] = pool[len(pal)]
            row += pal[c]
        rows.append(row)
    colors = {ch: c for c, ch in pal.items()}
    # trim empty columns and rows so the art sits flush like the hand-made Arch one
    keep = [x for x in range(n) if any(r[x] != "." for r in rows)]
    rows = [r[keep[0]:keep[-1] + 1] for r in rows if r.strip(".")]
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(cache, "w") as f:
            json.dump({"key": key, "rows": rows, "colors": {k2: list(v) for k2, v in colors.items()}}, f)
    except OSError:
        pass
    return rows, colors


def write_distro_logo(s, d=None):
    """generated/distro-logo.png: the pixel version of your distro's logo for the shell (1 px per pixel;
    the shell scales it up in whole steps so it stays crisp). Returns the distro info."""
    d = d or distro_info(s)
    out = os.path.join(GEN, "distro-logo.png")
    art = distro_pixels(d["logoFile"]) if d["logo"] == "system" else None
    if not art:
        if d["logo"] == "system":
            d["logo"] = "generic"
        return d
    rows, colors = art
    try:
        from PIL import Image
        img = Image.new("RGBA", (DISTRO_LOGO_GRID, DISTRO_LOGO_GRID), (0, 0, 0, 0))
        oy = (DISTRO_LOGO_GRID - len(rows)) // 2
        ox = (DISTRO_LOGO_GRID - len(rows[0])) // 2
        for y, r in enumerate(rows):
            for x, ch in enumerate(r):
                if ch != ".":
                    img.putpixel((ox + x, oy + y), colors[ch] + (255,))
        buf = io.BytesIO()
        img.save(buf, format="PNG")
        data = buf.getvalue()
        try:
            with open(out, "rb") as f:
                same = f.read() == data
        except OSError:
            same = False
        if not same:
            tmp = out + ".tmp"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, out)
        d["logoPng"] = out
        d["logoStamp"] = int(os.stat(out).st_mtime)       # so the shell reloads it when it changes
    except Exception:  # noqa: BLE001
        d["logo"] = "generic"
    return d


def write_fastfetch(s, p):
    """fastfetch in the terminal, laid out like the System info widget: the pixel Arch logo,
    user@host with a rule under it, short keys, the colour blocks — recoloured with the wallpaper."""
    d = os.path.join(HOME, ".config", "fastfetch")
    conf = os.path.join(d, "config.jsonc")
    if os.path.exists(conf):
        with open(conf) as f:
            if "bevel-generated" not in f.read(300):
                return            # the user has their own fastfetch config; leave it alone

    def rgb(x):
        r, g, b = (round(c * 255) for c in hex_to_rgb(x))
        return "%d;%d;%d" % (r, g, b)

    keyc = "1;38;2;" + rgb(p["accent2"])
    fg, bg = hex_to_rgb(p["termFg"]), hex_to_rgb(p["termBg"])
    dim = "38;2;" + rgb(rgb_to_hex(tuple(f * 0.55 + b * 0.45 for f, b in zip(fg, bg))))
    mono = colorsys.rgb_to_hls(*hex_to_rgb(p["accent"]))[2] < 0.08
    logo_file = os.path.join(d, "bevel-logo.txt")
    pad = {"top": 1, "left": 2, "right": 3}
    # the logo: Bevel's pixel Arch, your distro's own logo turned into the same kind of pixel art,
    # fastfetch's built-in text logo ("classic", or when no logo picture is installed), or none
    di = distro_info(s)
    art = None
    if di["logo"] == "arch":
        art = (ARCH_ART, {"A": (255, 255, 255), "a": (192, 192, 192), "n": (128, 128, 128)} if mono
               else {"A": (91, 188, 240), "a": (23, 147, 209), "n": (11, 95, 138)})
    elif di["logo"] == "system" and di["logoMode"] == "auto":
        art = distro_pixels(di["logoFile"])
        if art and mono:
            art = (art[0], {k: (round(sum(v) / 3),) * 3 for k, v in art[1].items()})
    if di["logo"] == "none":
        logo = {"type": "none"}
    elif art:
        logo = {"type": "file-raw", "source": logo_file, "width": len(art[0][0]), "height": (len(art[0]) + 1) // 2,
                "padding": pad}
    else:
        logo = {"padding": pad}

    def mod(t, key, **kw):
        m = {"type": t, "key": key}
        m.update(kw)
        return m
    btw = s.get("fun", {}).get("btwFastfetch", True)
    import getpass
    import socket
    try:
        rule = "%s@%s" % (getpass.getuser(), socket.gethostname().split(".")[0])
    except Exception:  # noqa: BLE001
        rule = "user@host"
    cfg = {
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": logo,
        "display": {
            "separator": " ",
            "color": {"keys": keyc, "title": keyc, "output": "38;2;" + rgb(p["termFg"]), "separator": "38;2;" + rgb(p["termFg"])},
            "key": {"width": 9},
        },
        "modules": [
            {"type": "title", "color": {"user": keyc, "at": dim, "host": keyc}},
            {"type": "custom", "format": "{#%s}%s{#}" % (dim, "─" * len(rule))},
            mod("os", "OS", format="{pretty-name}"),
            mod("kernel", "Kernel", format="{release}"),
            mod("uptime", "Uptime"),
            mod("packages", "Pkgs"),
            mod("wm", "WM", format="{pretty-name}"),
            mod("cpu", "CPU", format="{name}"),
            mod("memory", "Memory", format="{used} / {total}"),
            mod("gpu", "GPU", format="{name}"),
            mod("shell", "Shell", format="{pretty-name}"),
            mod("terminal", "Term", format="{pretty-name}"),
            mod("disk", "Disk", folders="/", format="{size-used} / {size-total}"),
            mod("battery", "Battery", format="{capacity} {status}"),
            {"type": "custom", "format": ""},
            {"type": "colors", "symbol": "block", "paddingLeft": 0, "block": {"width": 3, "range": [0, 7]}},
            *([{"type": "custom", "format": "{#%s}%s.{#}" % (dim, btw_text(s))}] if btw else []),
        ],
    }
    text = "// bevel-generated — delete this line to keep your own edits (bevelctl will stop touching the file)\n" + json.dumps(cfg, indent=2, ensure_ascii=False) + "\n"
    if art:
        write_atomic(logo_file, halfblock_art(*art))
    write_atomic(conf, text)


# ---------------------------------------------------------------- GTK theme
C95_SRC = os.path.join(SHARE, "chicago95")
THEME_DIR = os.path.join(HOME, ".themes", "Bevel")


def palette_key(p):
    return json.dumps({k: v for k, v in p.items() if k != "ansi"}, sort_keys=True)


def write_gtk_theme(s, p):
    """Recolor the Chicago95 Windows 95 GTK3 theme into ~/.themes/Bevel."""
    if not os.path.isdir(C95_SRC):
        return
    stamp = os.path.join(THEME_DIR, ".bevel-palette")
    key = "v4|" + palette_key(p)          # bump when the generated theme changes shape
    try:
        with open(stamp) as f:
            if f.read() == key:
                return                                   # already in these colors
    except OSError:
        pass
    import re
    tmp = THEME_DIR + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(os.path.join(C95_SRC, "gtk-3.0"), os.path.join(tmp, "gtk-3.0"), symlinks=False)
    for alias in ("gtk-3.22", "gtk-3.24"):
        os.symlink("gtk-3.0", os.path.join(tmp, alias))

    # 1) the CSS colour block
    css_map = {
        "bg_color": p["face"], "fg_color": p["text"], "panel_fg_color": p["text"], "panel_fg_color_bright": p["hi"],
        "base_color": p["base"], "text_color": p["text"], "text_color_light": p["textDim"],
        "selected_bg_color": p["accent"], "selected_fg_color": p["onAccent"],
        "selected_inactive_bg_color": p["lo"], "selected_inactive_fg_color": p["text"],
        "tooltip_bg_color": p["face2"], "tooltip_bg_shade": p["lo"], "tooltip_fg_color": p["text"],
        "bg_bright": p["base"], "border_bright": p["hi"], "border_light": p["face2"], "border_dark": p["dark"],
        "border_shade": p["lo"], "border_shade_dark": p["dark"], "outline_color": p["text"], "font_bright": p["hi"],
        "icon_shadow": p["dark"], "icon_shadow_bright": p["hi"], "scrollbar_trough_bg_color": p["face2"],
        "inactive_title_bg_color": p["lo"], "inactive_title_text_color": p["face"],
        "info_bg_color": p["face2"], "warning_bg_color": p["face2"], "question_bg_color": p["face2"],
    }
    css = os.path.join(tmp, "gtk-3.0", "gtk.css")
    with open(css) as f:
        text = f.read()
    for name, val in css_map.items():
        text = re.sub(r"(@define-color\s+%s\s+)[^;]+;" % re.escape(name), r"\g<1>%s;" % val, text)
    with open(css, "w") as f:
        f.write(text + "\n" + gtk_colors_css(p))

    # 2) the bevel images: swap the five classic 95 colours pixel by pixel
    try:
        from PIL import Image
        px_map = {(0xc0, 0xc0, 0xc0): p["face"], (0x80, 0x80, 0x80): p["lo"], (0xff, 0xff, 0xff): p["hi"],
                  (0xdf, 0xdf, 0xdf): p["face2"], (0x00, 0x00, 0x00): p["dark"], (0x00, 0x00, 0x80): p["accent"]}
        px_map = {k: tuple(round(c * 255) for c in hex_to_rgb(v)) for k, v in px_map.items()}
        for root_dir, _dirs, files in os.walk(os.path.join(tmp, "gtk-3.0")):
            for fn in files:
                if not fn.endswith(".png"):
                    continue
                fp = os.path.join(root_dir, fn)
                im = Image.open(fp).convert("RGBA")
                pixels = im.get_flattened_data() if hasattr(im, "get_flattened_data") else im.getdata()
                data = [(px_map[(r, g, b)] + (a,)) if (r, g, b) in px_map and a else (r, g, b, a) for (r, g, b, a) in pixels]
                im.putdata(data)
                im.save(fp)
    except ImportError:
        pass

    with open(os.path.join(tmp, "index.theme"), "w") as f:
        f.write("[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Bevel\nComment=Chicago95 recolored by Bevel\n\n"
                "[X-GNOME-Metatheme]\nGtkTheme=Bevel\nMetacityTheme=Bevel\nIconTheme=%s\n"
                % ("breeze-dark" if s["colors"].get("darkPanels") else "breeze"))
    with open(os.path.join(tmp, ".bevel-palette"), "w") as f:
        f.write(key)
    old = THEME_DIR + ".old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.isdir(THEME_DIR):
        os.replace(THEME_DIR, old)
    os.makedirs(os.path.dirname(THEME_DIR), exist_ok=True)
    os.replace(tmp, THEME_DIR)
    shutil.rmtree(old, ignore_errors=True)


def _c(h):
    return tuple(int(h.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4))


def _mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def _lum(c):
    return (0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]) / 255


def icon_theme(s):
    """Chicago95 for the 9x look (when it's installed), else Breeze."""
    choice = s["style"].get("icons") or "retro"
    if choice == "retro" and retro_icons_installed():
        return "Chicago95"
    return "breeze-dark" if s["colors"].get("darkPanels") else "breeze"


def write_qs_icons(s, p=None):
    """Tell Quickshell which icon theme to use (pragma at the top of each entry file).
    Quickshell reloads by itself when the line changes."""
    theme = icon_theme(s)
    folder = os.path.join(HOME, ".config", "quickshell", "bevel")
    for name in ("shell.qml", "settings.qml"):
        f = os.path.join(folder, name)
        try:
            lines = open(f).read().split("\n")
        except OSError:
            continue
        want = "//@ pragma IconTheme %s" % theme
        idx = [i for i, ln in enumerate(lines) if ln.startswith("//@ pragma IconTheme")]
        if idx:
            if lines[idx[0]] == want:
                continue
            lines[idx[0]] = want
        else:
            last = max([i for i, ln in enumerate(lines) if ln.startswith("//@ pragma")] or [-1])
            lines.insert(last + 1, want)
        write_atomic(f, "\n".join(lines))


def retro_icons_installed():
    return any(os.path.exists(os.path.join(d, "Chicago95", "index.theme"))
               for d in (os.path.join(HOME, ".local", "share", "icons"), os.path.join(HOME, ".icons"), "/usr/share/icons"))


FLYOUT_KINDS = ("clock", "battery", "sound", "network", "system", "notifs")


# ---------------------------------------------------------------- preconfigured apps
# Each app gets your colours (and a retro touch) only when it is installed, and only in
# files Bevel created itself (marked "bevel-generated"), so your own configs are left alone.
def _mine(path, marker="bevel-generated"):
    if not os.path.exists(path):
        return True
    try:
        with open(path, errors="ignore") as f:
            return marker in f.read(400)
    except OSError:
        return False


def _hex(c):
    return "#%02x%02x%02x" % tuple(c)


def _nearest256(hexc):
    """Closest xterm-256 colour index (for terminal apps that can't take #rrggbb)."""
    r, g, b = _c(hexc)
    levels = [0, 95, 135, 175, 215, 255]
    best, bi = None, 16
    for i in range(16, 256):
        if i < 232:
            n = i - 16
            cr, cg, cb = levels[n // 36], levels[(n // 6) % 6], levels[n % 6]
        else:
            cr = cg = cb = 8 + (i - 232) * 10
        d = (cr - r) ** 2 + (cg - g) ** 2 + (cb - b) ** 2
        if best is None or d < best:
            best, bi = d, i
    return bi


def editor_colors(s, p):
    """The colours code editors use: the terminal's (dark by default) plus the UI accent."""
    a = p["ansi"]
    dark = bool(s["colors"].get("darkTerminal", True))
    bg, fg = (p["termBg"], p["termFg"]) if dark else (p["base"], p["text"])
    return dict(bg=bg, fg=fg, dark=dark, bg2=_hex(_mix(_c(bg), _c(fg), 0.06)), bg3=_hex(_mix(_c(bg), _c(fg), 0.14)),
                dim=_hex(_mix(_c(bg), _c(fg), 0.45)), comment=a["color8"] if dark else p["textDim"],
                red=a["color1"], green=a["color2"], yellow=a["color3"], blue=a["color4"], magenta=a["color5"],
                cyan=a["color6"], accent=p["accent"], accent2=p["accent2"], on_accent=p["onAccent"],
                face=p["face"], face2=p["face2"], hi=p["hi"], lo=p["lo"], dark_c=p["dark"], text=p["text"],
                text_dim=p["textDim"], base=p["base"])


# ---- VS Code / Code - OSS / VSCodium
VSCODE_EXT_DIRS = (".vscode/extensions", ".vscode-oss/extensions")
VSCODE_SETTINGS = ("Code", "Code - OSS", "VSCodium")


