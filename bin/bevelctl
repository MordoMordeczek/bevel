# ---- Audacious: a Winamp-style skin in your colours
def audacious_skin_dir():
    return os.path.join(HOME, ".local", "share", "audacious", "Skins", "Bevel")


def write_audacious(s, p):
    if not shutil.which("audacious"):
        return
    src = next((d for d in ("/usr/share/audacious/Skins/Classic", "/usr/share/audacious/Skins/Default") if os.path.isdir(d)), None)
    if not src:
        return
    out = audacious_skin_dir()
    key = "1|" + palette_key(p)
    stamp = os.path.join(out, ".bevel-palette")
    try:
        with open(stamp) as f:
            if f.read() == key:
                return
    except OSError:
        pass
    try:
        from PIL import Image
    except ImportError:
        return
    face, hi, lo, dark = _c(p["face"]), _c(p["hi"]), _c(p["lo"]), _c(p["dark"])
    lcd, lcd_bg, acc = _c(p.get("lcd", p["accent2"])), _c(p.get("lcdBg", p["dark"])), _c(p["accent"])
    stops = [(0.0, dark), (0.45, lo), (0.82, face), (1.0, hi)]

    def grey(l):
        for (a, ca), (b, cb) in zip(stops, stops[1:]):
            if l <= b:
                return _mix(ca, cb, (l - a) / (b - a))
        return hi
    import colorsys as cs
    lut = {}

    def remap(px):
        r, g, b = px[:3]
        k = (r, g, b)
        if k not in lut:
            h, l, sat = cs.rgb_to_hls(r / 255, g / 255, b / 255)
            if sat > 0.25 and 0.12 < l < 0.95:           # coloured bits (LCD text, lights): LCD colour
                lut[k] = _mix(lcd_bg, lcd, min(1.0, l * 1.4))
            elif l < 0.06:                              # the black display panel
                lut[k] = lcd_bg
            else:
                lut[k] = grey(l)
        return lut[k] + tuple(px[3:])

    tmp = out + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp)
    for fn in os.listdir(tmp):
        fp = os.path.join(tmp, fn)
        if fn.lower().endswith((".png", ".bmp")):
            im = Image.open(fp)
            mode = "RGBA" if im.mode in ("RGBA", "LA", "P") else "RGB"
            im = im.convert(mode)
            im.putdata([remap(px) for px in (im.get_flattened_data() if hasattr(im, "get_flattened_data") else im.getdata())])
            im.save(fp)
    with open(os.path.join(tmp, "pledit.txt"), "w") as f:
        f.write("[Text]\nNormal=%s\nCurrent=%s\nNormalBG=%s\nSelectedBG=%s\n"
                % (_hex(lcd), p["hi"], _hex(lcd_bg), p["accent"]))
    vis = [lcd_bg, _mix(lcd_bg, lo, 0.4)] + [_mix(_c(p["accent2"]), acc, i / 15) for i in range(16)] + [lcd] * 5 + [hi]
    with open(os.path.join(tmp, "viscolor.txt"), "w") as f:
        f.write("".join("%d,%d,%d\n" % c for c in vis))
    with open(os.path.join(tmp, ".bevel-palette"), "w") as f:
        f.write(key)
    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    os.replace(tmp, out)


def audacious_setup():
    """Use the Winamp-style interface with the Bevel skin (only while Audacious isn't running)."""
    if not shutil.which("audacious"):
        return
    uid = str(os.getuid())
    r = run(["pgrep", "-u", uid, "-x", "audacious"])
    if r and r.returncode == 0:
        log("audacious: running, so the skin is switched on next time you run bevelctl apps-setup")
        return
    d = os.path.join(HOME, ".config", "audacious")
    reg = os.path.join(d, "plugin-registry")
    if not os.path.exists(reg) and shutil.which("audtool"):
        # first run creates the plugin list; do it without a window
        proc = subprocess.Popen(["audacious", "-H"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        time.sleep(3)
        run(["audtool", "shutdown"])
        try:
            proc.wait(timeout=4)
        except subprocess.TimeoutExpired:
            proc.terminate()                    # SIGTERM: Audacious still saves its settings
            try:
                proc.wait(timeout=4)
            except subprocess.TimeoutExpired:
                proc.kill()
    if os.path.exists(reg):
        with open(reg) as f:
            lines = f.read().split("\n")
        blocks, cur = [], None
        for i, ln in enumerate(lines):          # a block starts with "<type> <path>"
            if ln.startswith("iface "):
                cur = {"start": i, "path": ln.split(" ", 1)[1], "flags": None, "enabled": None}
                blocks.append(cur)
            elif cur is not None and ln.startswith("flags "):
                cur["flags"] = ln.split()[1]
            elif cur is not None and ln.startswith("enabled "):
                cur["enabled"] = i
                cur = None
        # the Winamp interface exists for both the Qt and the GTK mode: switch both on
        skins = [b for b in blocks if os.path.basename(b["path"]).startswith("skins") and b["enabled"] is not None]
        if skins:
            for b in blocks:
                if b["enabled"] is not None:
                    lines[b["enabled"]] = "enabled 1" if b in skins else "enabled 0"
            write_atomic(reg, "\n".join(lines))
    cfg = os.path.join(d, "config")
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    cp.optionxform = str
    try:
        cp.read(cfg)
    except configparser.Error:
        return
    if not cp.has_section("skins"):
        cp.add_section("skins")
    cp.set("skins", "skin", audacious_skin_dir())
    buf = io.StringIO()
    cp.write(buf, space_around_delimiters=False)
    os.makedirs(d, exist_ok=True)
    write_atomic(cfg, buf.getvalue())


def write_apps(s, p):
    for w in (write_vscode, write_nvim, write_btop, write_cava, write_cmus, write_zathura, write_imv, write_mpv, write_audacious):
        try:
            w(s, p)
        except Exception as e:  # noqa: BLE001
            log("ERROR %s: %s" % (w.__name__, e))


def apps_setup():
    """One-time setup after installing apps: VS Code theme extension, Audacious skin mode, Neovim starter."""
    s = load_settings()
    p = build_palette(s)
    write_apps(s, p)
    for step in (lambda: vscode_setup(s, p), audacious_setup, nvim_setup):
        try:
            step()
        except Exception as e:  # noqa: BLE001
            log("ERROR apps-setup: %s" % e)
    write_apps(s, p)


# ---------------------------------------------------------------- the OPSEC easter egg
# About → click the BEVEL logo. A very serious hacker workspace opens; closing the
# "WELCOME TO OPSEC" window puts everything back. (A TikTok meme. Nothing here does anything.)
OPSEC_STATE = os.path.join(CACHE, "opsec.json")


def hypr_workspace(n):
    for t in ('hl.dsp.focus({ workspace = %s })' % n, 'hl.dsp.workspace(%s)' % n):
        r = run(["hyprctl", "dispatch", t])
        if r and r.returncode == 0 and r.stdout.strip().lower() == "ok":
            return
    run(["hyprctl", "dispatch", "workspace", str(n)])


def opsec_start():
    if os.path.exists(OPSEC_STATE):
        opsec_stop()
    state = {"ws": None, "pids": []}
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        try:
            state["ws"] = json.loads(run(["hyprctl", "-j", "activeworkspace"]).stdout)["id"]
            used = {w["id"] for w in json.loads(run(["hyprctl", "-j", "workspaces"]).stdout)}
            free = next(i for i in range(1, 100) if i not in used)
            hypr_workspace(free)
            time.sleep(0.25)
        except Exception as e:  # noqa: BLE001
            log("opsec: workspace switch failed: %s" % e)
    me = SELF + ["opsec-fx"]
    panes = [("mainframe.exe", (["cmatrix", "-b", "-u", "4"] if shutil.which("cmatrix") else me + ["matrix"])),
             ("payload.c", me + ["code"]),
             ("nmap -sS 127.0.0.1", me + ["scan"]),
             ("hashcat --brrr", me + ["crack"]),
             ("tail -f /var/log/hacking", me + ["hack"]),
             ("hexdump /dev/urandom", me + ["hex"])]
    if shutil.which("kitty"):
        for title, cmd in panes:
            p = subprocess.Popen(["kitty", "--class", "bevel-opsec", "--title", title,
                                  "-o", "background=#000000", "-o", "foreground=#33ff66", "-o", "cursor=#33ff66",
                                  "-o", "font_size=10", "-o", "confirm_os_window_close=0", "-o", "background_opacity=0.92",
                                  "-o", "window_padding_width=4"] + cmd,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            state["pids"].append(p.pid)
            time.sleep(0.18)
    p = subprocess.Popen(me + ["notify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    state["pids"].append(p.pid)
    write_atomic(OPSEC_STATE, json.dumps(state))


def opsec_stop():
    try:
        with open(OPSEC_STATE) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {"ws": None, "pids": []}
    for pid in state.get("pids", []):
        try:
            os.killpg(pid, 15)            # each pane runs in its own session/group
        except OSError:
            try:
                os.kill(pid, 15)
            except OSError:
                pass
    run(["pkill", "-u", str(os.getuid()), "-f", "bevelctl opsec-fx [a-z]+$"])
    if state.get("ws") is not None:
        time.sleep(0.2)
        hypr_workspace(state["ws"])
    try:
        os.remove(OPSEC_STATE)
    except OSError:
        pass


def opsec_fx(kind):
    """The terminal shows. All fake, all harmless, all very green."""
    import itertools
    import string
    out = sys.stdout
    G, B, R, Y, D, X = "\033[1;32m", "\033[1;97m", "\033[1;31m", "\033[1;33m", "\033[2;32m", "\033[0m"

    def size():
        s = shutil.get_terminal_size((80, 24))
        return s.columns, s.lines

    def slow(text, delay=0.012):
        for ch in text:
            out.write(ch)
            out.flush()
            time.sleep(delay)
        out.write("\n")
        out.flush()

    rnd = random.Random()
    ip = lambda: "%d.%d.%d.%d" % (rnd.randint(11, 223), rnd.randint(0, 255), rnd.randint(0, 255), rnd.randint(1, 254))
    hexs = lambda n: "".join(rnd.choice("0123456789abcdef") for _ in range(n))
    try:
        if kind == "notify":
            msgs = [("OPSEC", "VPN connected: 7 proxies deep."), ("OPSEC", "Hoodie: ON. Sunglasses: ON (indoors)."),
                    ("Firewall", "Firewall bypassed. It was not plugged in."), ("Mainframe", "Mainframe accessed. It says hi."),
                    ("OPSEC", "IP hidden. (It's 127.0.0.1.)"), ("Threat level", "TikTok.")]
            for title, body in msgs:
                time.sleep(rnd.uniform(1.2, 2.4))
                run(["notify-send", "-a", "OPSEC", title, body])
            return 0
        out.write("\033[?25l")
        if kind == "matrix":
            w, h = size()
            drops = [rnd.randint(-h, 0) for _ in range(w)]
            chars = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄ0123456789$#@%&*"
            out.write("\033[2J")
            while True:
                w, h = size()
                if len(drops) < w:
                    drops += [0] * (w - len(drops))
                for x in range(0, w, 2):
                    y = drops[x]
                    if 0 < y <= h:
                        out.write("\033[%d;%dH%s%s" % (y, x + 1, B, rnd.choice(chars)))
                    if 1 < y <= h + 1:
                        out.write("\033[%d;%dH%s%s" % (y - 1, x + 1, G, rnd.choice(chars)))
                    if y - 12 > 0:
                        out.write("\033[%d;%dH " % (y - 12, x + 1))
                    drops[x] = y + 1 if y < h + 12 else rnd.randint(-h // 2, 0)
                out.flush()
                time.sleep(0.05)
        elif kind == "code":
            try:
                with open(os.path.abspath(__file__)) as f:
                    src = f.read().splitlines()
            except OSError:
                src = ["int main() { hack(); return 0; }"]
            i = rnd.randint(0, max(0, len(src) - 1))
            while True:
                line = src[i % len(src)]
                col = Y if line.strip().startswith(("def ", "class ")) else (D if line.strip().startswith("#") else G)
                out.write(col)
                slow(line[:size()[0] - 1], 0.004)
                i += 1
        elif kind == "scan":
            while True:
                target = rnd.choice(["127.0.0.1", "localhost", "the-mainframe.local", "fbi.gov.totally.real", ip()])
                slow(G + "Starting Nmap 9.99 ( https://nmap.org ) against %s" % target, 0.01)
                slow(D + "Scanning %d ports [stealth: maximum, hoodie: up]" % rnd.choice([1000, 65535]), 0.01)
                for port, svc in rnd.sample([(22, "ssh"), (80, "http"), (443, "https"), (1337, "elite"), (8080, "http-proxy"),
                                             (31337, "back-orifice"), (6969, "nice"), (25565, "minecraft"), (3306, "mysql")], 5):
                    time.sleep(rnd.uniform(0.15, 0.5))
                    state = rnd.choice(["open", "open", "filtered", "suspicious"])
                    slow((G if state == "open" else Y) + "%-10s %-11s %s" % ("%d/tcp" % port, state, svc), 0.005)
                slow(B + "ACCESS GRANTED" + X if rnd.random() < 0.6 else R + "ACCESS DENIED (retrying with more hoodie)" + X, 0.02)
                time.sleep(0.8)
                out.write("\n")
        elif kind == "crack":
            words = ["hunter2", "password123", "letmein", "iusearchbtw", "correcthorsebatterystaple", "qwerty", "admin", "bevel"]
            while True:
                target = hexs(32)
                slow(G + "[*] Target hash: " + B + target, 0.005)
                tries = 0
                for _ in range(rnd.randint(40, 90)):
                    tries += rnd.randint(9000, 99999)
                    guess = "".join(rnd.choice(string.ascii_letters + string.digits) for _ in range(rnd.randint(6, 12)))
                    out.write("\r" + D + "    trying %-14s %s  %11s H/s   " % (guess, hexs(16), "{:,}".format(tries)))
                    out.flush()
                    time.sleep(0.04)
                out.write("\n")
                slow(B + "[+] PASSWORD FOUND: " + Y + rnd.choice(words) + X, 0.03)
                time.sleep(1.2)
        elif kind == "hack":
            lines = itertools.cycle([
                "Bypassing firewall...", "Injecting SQL into the coffee machine...", "Downloading more RAM...",
                "Decrypting 4096-bit RSA by squinting...", "Rerouting through %d proxies..." % rnd.randint(7, 99),
                "Uploading virus.exe to the mainframe...", "Disabling the cookies (the browser ones)...",
                "Hacking the Gibson...", "Enhance. Enhance. ENHANCE.", "Compiling the kernel in my head...",
                "sudo make me a sandwich", "Pinging the matrix...", "Spoofing MAC address to 00:00:DE:AD:BE:EF...",
                "Opening a backdoor (it was a regular door)...", "Encrypting the encryption...",
            ])
            while True:
                ts = time.strftime("%H:%M:%S")
                slow("%s[%s]%s %s%s" % (D, ts, G, next(lines), X), 0.015)
                bar = "".join("█" if i < rnd.randint(4, 30) else "░" for i in range(30))
                slow("%s        [%s] %d%%%s" % (G, bar, rnd.randint(12, 100), X), 0.002)
                time.sleep(rnd.uniform(0.2, 0.7))
                if rnd.random() < 0.15:
                    slow(R + "        !! INTRUSION DETECTED !! (it's you)" + X, 0.01)
        elif kind == "hex":
            off = 0
            while True:
                b = [rnd.randint(0, 255) for _ in range(16)]
                txt = "".join(chr(x) if 32 <= x < 127 else "." for x in b)
                out.write("%s%08x  %s  %s  %s|%s|%s\n" % (D, off, " ".join("%02x" % x for x in b[:8]),
                                                       " ".join("%02x" % x for x in b[8:]), G, txt, X))
                out.flush()
                off += 16
                time.sleep(0.03)
    except (KeyboardInterrupt, BrokenPipeError, OSError):
        pass
    return 0


# ---------------------------------------------------------------- Firefox
def firefox_profiles():
    out = []
    for base in (os.path.join(HOME, ".mozilla", "firefox"), os.path.join(HOME, ".config", "mozilla", "firefox")):
        ini = os.path.join(base, "profiles.ini")
        if not os.path.exists(ini):
            continue
        cp = configparser.RawConfigParser(strict=False)
        cp.optionxform = str
        try:
            cp.read(ini)
        except configparser.Error:
            continue
        for sec in cp.sections():
            if sec.startswith("Profile") and cp.has_option(sec, "Path"):
                path = cp.get(sec, "Path")
                rel = cp.get(sec, "IsRelative", fallback="1") == "1"
                full = os.path.join(base, path) if rel else path
                if os.path.isdir(full):
                    out.append(full)
    return out


def write_firefox(s, p):
    """9x-style Firefox chrome in the Bevel colours (takes effect when Firefox restarts)."""
    if not s.get("firefox", {}).get("theme", True):
        return
    font = s["style"].get("font", "Pixelify Sans")
    css = f"""/* bevel-generated — delete this line to keep your own userChrome.css (bevelctl stops touching it) */
