def cursor_cfg(s):
    c = s.get("cursor", {})
    return {"style": c.get("style", "bevel"), "color": c.get("color", "white"), "custom": c.get("custom", "#ffcc00"),
            "size": int(c.get("size", 24) or 24)}


def cursor_colours(s, p):
    """fill, outline, sand — as 0-255 tuples."""
    c = cursor_cfg(s)
    rgb255 = lambda h: tuple(round(v * 255) for v in hex_to_rgb(h))
    mode = c["color"]
    if mode == "black":
        fill, line = (0, 0, 0), (255, 255, 255)
    elif mode == "accent":
        fill = rgb255(p["accent"])
        line = (0, 0, 0) if _lum(fill) > 0.25 else (255, 255, 255)
    elif mode == "custom":
        try:
            fill = rgb255(c["custom"])
        except (ValueError, TypeError):
            fill = (255, 204, 0)
        line = (0, 0, 0) if _lum(fill) > 0.25 else (255, 255, 255)
    else:
        fill, line = (255, 255, 255), (0, 0, 0)
    sand = rgb255(p["accent"]) if mode in ("white", "black") else (214, 168, 74)
    return fill, line, sand


def _cursor_frames(name):
    """The pixel rows of each frame (the hourglass trickles)."""
    art, hx, hy, mirror, _ = CURSORS[name]
    rows = CURSOR_ART[art].split("\n")
    if mirror:
        w = max(len(r) for r in rows)
        rows = [r.ljust(w, ".")[::-1] for r in rows]
    if name == "progress":                     # an arrow with a little hourglass
        rows = [r.ljust(19, ".") for r in rows]
        for i, g in enumerate(CURSOR_MINI_GLASS):
            y = 11 + i
            while len(rows) <= y:
                rows.append("." * 19)
            rows[y] = rows[y][:11] + g + rows[y][18:]
        return [rows]
    if art != "hourglass":
        return [rows]
    frames = []
    top, bottom = list(range(3, 9)), list(range(16, 10, -1))
    for k in range(7):                          # sand runs from the top half into the bottom
        f = [list(r) for r in rows]
        for i, y in enumerate(top):
            if i >= k:
                f[y] = ["s" if ch == "f" else ch for ch in f[y]]
        for i, y in enumerate(bottom):
            if i < k:
                f[y] = ["s" if ch == "f" else ch for ch in f[y]]
        if 0 < k < 6:
            for y in (9, 10):
                f[y] = ["s" if ch == "f" else ch for ch in f[y]]
        frames.append(["".join(r) for r in f])
    return frames


def _xcursor_bytes(images):
    """images: [(nominal, w, h, xhot, yhot, delay, argb list)] → an Xcursor file."""
    import struct
    head = struct.pack("<4sIII", b"Xcur", 16, 0x10000, len(images))
    toc, chunks = b"", b""
    pos = 16 + 12 * len(images)
    for nominal, w, h, xh, yh, delay, px in images:
        toc += struct.pack("<III", 0xFFFD0002, nominal, pos)
        chunk = struct.pack("<IIIIIIIII", 36, 0xFFFD0002, nominal, 1, w, h, xh, yh, delay) + struct.pack("<%dI" % len(px), *px)
        chunks += chunk
        pos += len(chunk)
    return head + toc + chunks


def _cursor_image(rows, cols, scale, canvas=32):
    size = canvas * scale
    px = [0] * (size * size)
    for y, r in enumerate(rows):
        for x, ch in enumerate(r):
            c = cols.get(ch)
            if not c:
                continue
            v = 0xFF000000 | (c[0] << 16) | (c[1] << 8) | c[2]
            for dy in range(scale):
                base = (y * scale + dy) * size + x * scale
                if y * scale + dy >= size or x * scale >= size:
                    continue
                for dx in range(scale):
                    if x * scale + dx < size:
                        px[base + dx] = v
    return size, px


_CURSOR_NEW = False


def hypr_cursor(s):
    """Tell the running Hyprland to use the pointer — after any config reload, which would reset it.
    When the pictures were just redrawn, switch away and back so it really reloads them."""
    global _CURSOR_NEW
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or cursor_cfg(s)["style"] != "bevel":
        return
    size = str(cursor_cfg(s)["size"])
    if _CURSOR_NEW:
        run(["hyprctl", "setcursor", "Adwaita", size])
    run(["hyprctl", "setcursor", CURSOR_THEME, size])
    _CURSOR_NEW = False


def write_cursor(s, p):
    """Build the 9x mouse pointer theme in your colour and point Hyprland and GTK apps at it."""
    c = cursor_cfg(s)
    dflt = os.path.join(HOME, ".icons", "default", "index.theme")
    if c["style"] != "bevel":
        # "System default": hand the pointer back if it was ours
        r = run(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"])
        if r and CURSOR_THEME in r.stdout:
            run(["gsettings", "reset", "org.gnome.desktop.interface", "cursor-theme"])
            if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
                run(["hyprctl", "setcursor", "Adwaita", "24"])
        try:
            if "bevelctl" in open(dflt).read():
                os.remove(dflt)
        except OSError:
            pass
        return
    fill, line, sand = cursor_colours(s, p)
    cols = {"o": line, "f": fill, "s": sand, "r": (214, 40, 40)}
    base = os.path.join(HOME, ".local", "share", "icons", CURSOR_THEME)
    stamp = os.path.join(base, ".bevel-stamp")
    key = json.dumps([fill, line, sand, 2])
    fresh = False
    try:
        fresh = open(stamp).read() == key
    except OSError:
        pass
    # some programs only look in ~/.icons
    alt = os.path.join(HOME, ".icons", CURSOR_THEME)
    try:
        if not os.path.lexists(alt):
            os.makedirs(os.path.dirname(alt), exist_ok=True)
            os.symlink(base, alt)
    except OSError:
        pass
    if not fresh:
        d = os.path.join(base, "cursors")
        os.makedirs(d, exist_ok=True)
        for name, (art, hx, hy, mirror, aliases) in CURSORS.items():
            images = []
            frames = _cursor_frames(name)
            for scale in (1, 2, 3):
                for fr in frames:
                    size, px = _cursor_image(fr, cols, scale)
                    images.append((24 * scale, size, size, hx * scale, hy * scale, 160 if len(frames) > 1 else 0, px))
            with open(os.path.join(d, name), "wb") as f:
                f.write(_xcursor_bytes(images))
            for a in aliases:
                link = os.path.join(d, a)
                try:
                    if os.path.islink(link) or os.path.exists(link):
                        os.remove(link)
                    os.symlink(name, link)
                except OSError:
                    pass
        write_atomic(os.path.join(base, "index.theme"),
                     "[Icon Theme]\nName=%s\nComment=Windows 9x style pointers, made by bevelctl\nInherits=breeze_cursors,Adwaita,hicolor\n" % CURSOR_THEME)
        write_atomic(os.path.join(base, "cursor.theme"), "[Icon Theme]\nInherits=%s\n" % CURSOR_THEME)
        # a picture for Settings
        try:
            from PIL import Image
            im = Image.new("RGBA", (6 * 36, 36), (0, 0, 0, 0))
            for i, name in enumerate(("default", "pointer", "text", "wait", "ns-resize", "move")):
                rows = _cursor_frames(name)[2 if name == "wait" else 0]
                for y, r in enumerate(rows):
                    for x, ch in enumerate(r):
                        if cols.get(ch):
                            im.putpixel((i * 36 + 2 + x, 2 + y), cols[ch] + (255,))
            os.makedirs(CACHE, exist_ok=True)
            im.save(os.path.join(CACHE, "cursor-preview.png"))
        except Exception:  # noqa: BLE001
            pass
        with open(stamp, "w") as f:
            f.write(key)
    # X11 / Xwayland apps that don't ask anyone: the "default" cursor theme
    try:
        mine = not os.path.exists(dflt) or "bevelctl" in open(dflt).read()
    except OSError:
        mine = False
    if mine:
        write_atomic(dflt, "[Icon Theme]\n# set by bevelctl\nInherits=%s\n" % CURSOR_THEME)
    size = str(c["size"])
    run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", CURSOR_THEME])
    run(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", size])
    global _CURSOR_NEW
    _CURSOR_NEW = _CURSOR_NEW or not fresh


def write_gtk_settings(s):
    """Point GTK (Hyprland side) at the Bevel theme too, so both sessions match."""
    if not os.path.isdir(THEME_DIR):
        return
    dark = bool(s["colors"].get("darkPanels"))
    ini = os.path.join(HOME, ".config", "gtk-3.0", "settings.ini")
    cp = configparser.RawConfigParser()
    cp.optionxform = str
    try:
        cp.read(ini)
    except configparser.Error:
        pass
    if not cp.has_section("Settings"):
        cp.add_section("Settings")
    cp.set("Settings", "gtk-theme-name", "Bevel")
    cp.set("Settings", "gtk-icon-theme-name", icon_theme(s))
    cp.set("Settings", "gtk-font-name", "%s 10" % s["style"].get("font", "Pixelify Sans"))
    cp.set("Settings", "gtk-application-prefer-dark-theme", "1" if dark else "0")
    if cursor_cfg(s)["style"] == "bevel":
        cp.set("Settings", "gtk-cursor-theme-name", CURSOR_THEME)
        cp.set("Settings", "gtk-cursor-theme-size", str(cursor_cfg(s)["size"]))
    elif cp.get("Settings", "gtk-cursor-theme-name", fallback="") == CURSOR_THEME:
        cp.remove_option("Settings", "gtk-cursor-theme-name")
        cp.remove_option("Settings", "gtk-cursor-theme-size")
    cp.set("Settings", "gtk-enable-event-sounds", "0")
    cp.set("Settings", "gtk-enable-input-feedback-sounds", "0")
    buf = io.StringIO()
    cp.write(buf, space_around_delimiters=False)
    write_atomic(ini, buf.getvalue())
    run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "Bevel"])
    run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", icon_theme(s)])


def gtk_colors_css(p):
    return f"""/* generated by bevelctl */
@define-color accent_color {p['accent']};
@define-color accent_bg_color {p['accent']};
@define-color accent_fg_color {p['onAccent']};
@define-color window_bg_color {p['face']};
@define-color window_fg_color {p['text']};
@define-color view_bg_color {p['base']};
@define-color view_fg_color {p['text']};
@define-color headerbar_bg_color {p['face2']};
@define-color headerbar_fg_color {p['text']};
@define-color sidebar_bg_color {p['face2']};
@define-color popover_bg_color {p['face2']};
@define-color card_bg_color {p['face2']};
@define-color dialog_bg_color {p['face']};
@define-color theme_selected_bg_color {p['accent']};
@define-color theme_selected_fg_color {p['onAccent']};
@define-color theme_bg_color {p['face']};
@define-color theme_fg_color {p['text']};
@define-color theme_base_color {p['base']};
@define-color theme_text_color {p['text']};
"""


def write_gtk(s, p):
    css = gtk_colors_css(p)
    for ver in ("gtk-3.0", "gtk-4.0"):
        d = os.path.join(HOME, ".config", ver)
        os.makedirs(d, exist_ok=True)
        if ver == "gtk-3.0" and os.path.isdir(C95_SRC):
            # GTK 3 reads this file only when an app starts. The colours live in the Bevel
            # theme itself instead, which running apps reload when the theme switches.
            write_atomic(os.path.join(d, "bevel.css"), "/* generated by bevelctl: GTK 3 colours are in ~/.themes/Bevel */\n")
        else:
            write_atomic(os.path.join(d, "bevel.css"), css)
        main = os.path.join(d, "gtk.css")
        existing = ""
        if os.path.exists(main):
            with open(main) as f:
                existing = f.read()
        if "@import 'bevel.css';" not in existing:
            write_atomic(main, "@import 'bevel.css';\n" + existing)


