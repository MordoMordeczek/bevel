def nvim_setup():
    d = os.path.join(HOME, ".config", "nvim")
    if not shutil.which("nvim") or os.path.exists(os.path.join(d, "init.lua")) or os.path.exists(os.path.join(d, "init.vim")):
        return
    write_atomic(os.path.join(d, "init.lua"), """-- bevel-generated starter config: make it yours, Bevel won't touch it again once you edit this line
vim.o.number = true
vim.o.cursorline = true
vim.o.mouse = "a"
vim.o.clipboard = "unnamedplus"
vim.o.guicursor = "a:block"          -- chunky block cursor everywhere
vim.o.expandtab = true
vim.o.shiftwidth = 4
vim.o.tabstop = 4
pcall(vim.cmd.colorscheme, "bevel")
""")


